<!-- ══════════════════════════════════════ -->
<!--              FIREBASE + APP LOGIC     -->
<!-- ══════════════════════════════════════ -->
<script type="module">
import { initializeApp }      from "https://www.gstatic.com/firebasejs/9.22.0/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged, setPersistence, browserLocalPersistence }
                               from "https://www.gstatic.com/firebasejs/9.22.0/firebase-auth.js";
import { getDatabase, ref, update, onValue, set, push, remove, get, serverTimestamp, query, limitToLast, orderByChild, equalTo, onDisconnect }
                               from "https://www.gstatic.com/firebasejs/9.22.0/firebase-database.js";

// ══════════════════════════════════════
//  FIREBASE CONFIG
// ══════════════════════════════════════
const firebaseConfig = {
  apiKey: "AIzaSyD9w63g1Zz1RL8zNyvips5dLnjCmYpA4T0",
  authDomain: "logging-6dea2.firebaseapp.com",
  databaseURL: "https://logging-6dea2-default-rtdb.firebaseio.com",
  projectId: "logging-6dea2",
  storageBucket: "logging-6dea2.firebasestorage.app",
  messagingSenderId: "540225687965",
  appId: "1:540225687965:web:20dcfd7b7d2b40e639df74"
};

// FCM Key for push notifications
const FCM_KEY = "AIzaSyAQLRmywrD0NSibvuwiVbiO_YzBRRq5k98";

const fbApp = initializeApp(firebaseConfig);
const auth  = getAuth(fbApp);
const db    = getDatabase(fbApp);

// ══════════════════════════════════════
//  SECURITY SYSTEM
// ══════════════════════════════════════
const SEC = {
  MAX_ATTEMPTS:    5,
  LOCKOUT_MS:      30000,
  SESSION_TIMEOUT: 2 * 60 * 60 * 1000, // 2 hours
  attempts:        0,
  lockedUntil:     0,
  sessionStart:    0,
  sessionTimer:    null,
  log:             []
};

function secLog(type, msg) {
  const ev = { type, msg, time: new Date().toLocaleTimeString(), ts: Date.now() };
  SEC.log.unshift(ev);
  if (SEC.log.length > 50) SEC.log.pop();
  renderSecLog();
  // Persist security log in Firebase for audit trail
  push(ref(db, 'admin_security_log'), ev).catch(() => {});
}

function renderSecLog() {
  const el = document.getElementById('sec-log-list');
  if (!el) return;
  el.innerHTML = SEC.log.slice(0, 20).map(e => `
    <div class="sec-event ${e.type}">
      <i class="fa-solid ${e.type === 'ok' ? 'fa-check-circle' : e.type === 'error' ? 'fa-xmark-circle' : 'fa-triangle-exclamation'}"></i>
      <div><b>${e.time}</b> — ${xss(e.msg)}</div>
    </div>
  `).join('');
  document.getElementById('sec-ok-count').innerText   = SEC.log.filter(x => x.type === 'ok').length;
  document.getElementById('sec-fail-count').innerText = SEC.log.filter(x => x.type === 'error').length;
}

function startSessionTimer() {
  SEC.sessionStart = Date.now();
  if (SEC.sessionTimer) clearInterval(SEC.sessionTimer);
  SEC.sessionTimer = setInterval(() => {
    const age  = Date.now() - SEC.sessionStart;
    const left = SEC.SESSION_TIMEOUT - age;
    const mins = Math.floor(age / 60000);
    const el   = document.getElementById('sec-session-age');
    if (el) el.innerText = mins + 'm';
    // Session expiry warning at 10 min remaining
    if (left < 600000 && left > 599000) showToast("Session expires in 10 minutes. Please re-login.", "warn");
    // Auto logout on session expiry
    if (left <= 0) {
      showToast("Session expired. Logging out for security.", "error");
      signOut(auth).then(() => location.reload());
    }
    // Update session bar
    const bar = document.getElementById('session-bar');
    if (bar) bar.style.transform = `scaleX(${Math.max(0, left / SEC.SESSION_TIMEOUT)})`;
  }, 1000);
}

window.clearSecLog = () => { SEC.log = []; renderSecLog(); showToast("Security log cleared", "info"); };

// ══════════════════════════════════════
//  XSS PROTECTION (Escape HTML)
// ══════════════════════════════════════
const xss = (str) => {
  if (str === null || str === undefined) return '';
  return String(str).replace(/[&<>"'`=\/]/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#x27;','`':'&#x60;','=':'&#x3D;','/':'&#x2F;'}[s]));
};

// ══════════════════════════════════════
//  TOAST
// ══════════════════════════════════════
window.showToast = (msg, type = 'info') => {
  const c     = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = `toast ${type}`;
  const icons = { success:'fa-check-circle', error:'fa-circle-xmark', info:'fa-circle-info', warn:'fa-triangle-exclamation' };
  toast.innerHTML = `<i class="fa-solid ${icons[type]||icons.info}"></i> ${xss(msg)}`;
  c.appendChild(toast);
  setTimeout(() => { if (toast.parentElement) toast.remove(); }, 3200);
};

// ══════════════════════════════════════
//  CLOCK
// ══════════════════════════════════════
(function tickClock() {
  const el = document.getElementById('header-clock');
  if (el) el.innerText = new Date().toLocaleTimeString('en-IN', { hour12: true });
  setTimeout(tickClock, 1000);
})();

// ══════════════════════════════════════
//  AUDIO — unlock on first user gesture
// ══════════════════════════════════════
let AUDIO_UNLOCKED = false;
const audioEl = document.getElementById('order-sound');

function unlockAudio() {
  if (AUDIO_UNLOCKED || !audioEl) return;
  audioEl.muted = true;
  audioEl.play().then(() => {
    audioEl.pause(); audioEl.currentTime = 0; audioEl.muted = false;
    AUDIO_UNLOCKED = true;
  }).catch(() => {});
}
document.body.addEventListener('click', unlockAudio, { once: true });

function playOrderAlert() {
  if (!audioEl || !AUDIO_UNLOCKED) return;
  audioEl.currentTime = 0;
  audioEl.play().catch(() => {});
  // Visual browser notification
  if (Notification.permission === 'granted') {
    new Notification('🔔 New Order!', { body: 'A new order has been placed at Govinda\'s', icon: 'https://cdn-icons-png.flaticon.com/512/732/732200.png' });
  }
}

// Request browser notification permission
if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
  Notification.requestPermission();
}

// ══════════════════════════════════════
//  AUTH
// ══════════════════════════════════════
window.handleLogin = async () => {
  const now = Date.now();
  // Rate limit check
  if (now < SEC.lockedUntil) return;

  const email = document.getElementById('login-email').value.trim();
  const pass  = document.getElementById('login-pass').value;
  const btn   = document.getElementById('login-btn');
  const errEl = document.getElementById('auth-err');

  if (!email || !pass) { showToast("Email and password required", "error"); return; }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Authenticating...';
  errEl.innerText = '';

  try {
    await signInWithEmailAndPassword(auth, email, pass);
    SEC.attempts = 0;
    secLog('ok', `Successful login: ${email}`);
    showToast("Login successful — Hare Krishna! 🙏", "success");
    unlockAudio();
  } catch (err) {
    SEC.attempts++;
    secLog('error', `Failed login attempt ${SEC.attempts} for ${email}`);
    errEl.innerText = "Invalid credentials!";
    showToast(`Login failed! Attempt ${SEC.attempts}/${SEC.MAX_ATTEMPTS}`, "error");

    if (SEC.attempts >= SEC.MAX_ATTEMPTS) {
      SEC.lockedUntil = Date.now() + SEC.LOCKOUT_MS;
      const lockEl = document.getElementById('auth-lockout');
      lockEl.style.display = 'block';
      secLog('warn', `Account locked for 30 seconds after ${SEC.MAX_ATTEMPTS} failed attempts`);
      let t = 30;
      const iv = setInterval(() => {
        document.getElementById('lockout-timer').innerText = --t;
        if (t <= 0) { clearInterval(iv); lockEl.style.display = 'none'; SEC.attempts = 0; }
      }, 1000);
    }
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-shield-halved"></i> SECURE LOGIN';
  }
};

window.logout = async () => {
  if (!confirm("Securely logout from demo?")) return;
  secLog('ok', 'Admin logged out');
  await signOut(auth);
  location.reload();
};

// Auth persistence + state
setPersistence(auth, browserLocalPersistence).then(() => {
  onAuthStateChanged(auth, (user) => {
    if (user) {
      document.getElementById('view-auth').style.display = 'none';
      startSessionTimer();
      initApp();
      unlockAudio();
    } else {
      document.getElementById('view-auth').style.display = 'flex';
    }
  });
});

// ══════════════════════════════════════
//  APP STATE
// ══════════════════════════════════════
const DB = { orders:[], items:[], cats:[], drivers:[], banners:[], coupons:[], customers:[], reviews:{} };
let PREV_PENDING = 0;
let salesChart   = null;
let statusChart  = null;
let currentOrderFilter = 'all';
let chartMode    = 'week';

// ══════════════════════════════════════
//  INIT APP — all Firebase listeners
// ══════════════════════════════════════
function initApp() {
  // Settings
  onValue(ref(db, 'settings'), snap => {
    const s = snap.val() || {};
    const open = s.store_open !== false;
    const sw   = document.getElementById('master-switch');
    if (sw) sw.checked = open;
    document.getElementById('store-status-text').innerText = open ? 'ONLINE' : 'OFFLINE';
    const pill = document.getElementById('store-toggle');
    pill.className = `store-pill ${open ? 'online' : 'offline'}`;

    // Settings inputs
    const safe = (id, val) => { const el = document.getElementById(id); if (el) el.value = val; };
    safe('set-del-fee',      s.delivery_fee       || 20);
    safe('set-free-min',     s.min_free_delivery   || 500);
    safe('set-min-order',    s.min_order           || 100);
    safe('set-max-radius',   s.max_radius          || 10);
    safe('set-online-disc',  s.online_discount     || 0);
    const cod = document.getElementById('set-cod');
    if (cod) cod.checked = s.cod_enabled !== false;
  });

  // Menu
  onValue(ref(db, 'menu'), snap => {
    DB.items = snap.exists() ? Object.entries(snap.val()).map(([k,v]) => ({ id:k, ...v })) : [];
    renderMenuUI();
    document.getElementById('item-count').innerText = DB.items.length;
  });

  // Categories
  onValue(ref(db, 'categories'), snap => {
    DB.cats = snap.exists() ? Object.entries(snap.val()).map(([k,v]) => ({ id:k, ...v })) : [];
    renderCatUI();
  });

  // Orders — real-time, sorted, last 200
  onValue(query(ref(db, 'orders'), limitToLast(200)), snap => {
    DB.orders = snap.exists()
      ? Object.entries(snap.val()).map(([k,v]) => ({ id:k, ...v }))
      : [];

    // Sort by timestamp descending (newest first)
    DB.orders.sort((a, b) => {
      const ta = a.createdAt || a.timestamp || 0;
      const tb = b.createdAt || b.timestamp || 0;
      if (ta !== tb) return tb - ta;
      return b.id.localeCompare(a.id);
    });

    const newPending = DB.orders.filter(o => o.status === 'placed').length;
    if (newPending > PREV_PENDING) {
      playOrderAlert();
      showToast(`🔔 New order received! (${newPending} pending)`, "info");
      secLog('ok', `New order placed — ${newPending} pending`);
    }
    PREV_PENDING = newPending;
    renderDashboard();
    renderOrdersUI();
    renderDashRecentOrders();
  });

  // Customers
  onValue(ref(db, 'customers'), snap => {
    DB.customers = snap.exists() ? Object.entries(snap.val()).map(([k,v]) => ({ id:k, ...v })) : [];
    renderCustomersUI();
    renderLoyaltyUI();
    document.getElementById('d-custs').innerText = DB.customers.length;
  });

  // Reviews
  onValue(ref(db, 'reviews'), snap => {
    DB.reviews = snap.val() || {};
    renderReviewsUI();
  });

  // Drivers
  onValue(ref(db, 'deliveryPartners'), snap => {
    DB.drivers = snap.exists() ? Object.entries(snap.val()).map(([k,v]) => ({ id:k, ...v })) : [];
    renderDriversUI();
  });

  // Banners + Coupons
  onValue(ref(db, 'sliders'), snap => {
    DB.banners = snap.exists() ? Object.entries(snap.val()).map(([k,v]) => ({ id:k, ...v })) : [];
    renderMarketingUI();
  });

  onValue(ref(db, 'coupons'), snap => {
    DB.coupons = snap.exists() ? Object.entries(snap.val()).map(([k,v]) => ({ id:k, ...v })) : [];
    renderMarketingUI();
  });

  secLog('ok', 'Admin panel initialized successfully');
}

// ══════════════════════════════════════
//  DASHBOARD
// ══════════════════════════════════════
function renderDashboard() {
  const done    = DB.orders.filter(o => o.status === 'completed');
  const pending = DB.orders.filter(o => ['placed','cooking','driver_assigned','out_for_delivery'].includes(o.status)).length;
  const revenue = done.reduce((s, o) => s + (parseInt(o.total) || 0), 0);

  document.getElementById('d-sales').innerText   = '₹' + revenue.toLocaleString('en-IN');
  document.getElementById('d-orders').innerText  = done.length;
  document.getElementById('d-pending').innerText = pending;

  const badge = document.getElementById('nav-badge');
  if (pending > 0) { badge.style.display = 'inline-block'; badge.innerText = pending; }
  else badge.style.display = 'none';

  renderSalesChart();
  renderStatusChart();
}

function renderDashRecentOrders() {
  const tb = document.querySelector('#dash-recent-table tbody');
  if (!tb) return;
  const recent = DB.orders.slice(0, 8);
  tb.innerHTML = recent.map(o => {
    const statusMap = { placed:'bg-new', cooking:'bg-cook', out_for_delivery:'bg-out', completed:'bg-done', cancelled:'bg-can' };
    const cls = statusMap[o.status] || 'bg-new';
    return `<tr>
      <td><b>#${xss(o.id.slice(-4).toUpperCase())}</b></td>
      <td>${xss(o.userName)}</td>
      <td>₹${xss(o.total)}</td>
      <td><span class="badge ${cls}">${xss(o.status.replace('_',' '))}</span></td>
      <td style="font-size:0.75rem;color:var(--text-muted);">${o.createdAt ? new Date(o.createdAt).toLocaleTimeString('en-IN',{hour12:true}) : '--'}</td>
    </tr>`;
  }).join('');
}

// ──── SALES CHART ────
function renderSalesChart() {
  const days   = chartMode === 'week' ? 7 : 30;
  const labels = [];
  const data   = [];

  for (let i = days - 1; i >= 0; i--) {
    const d = new Date();
    d.setDate(d.getDate() - i);
    const key = d.toLocaleDateString('en-IN', { day:'numeric', month:'short' });
    labels.push(key);
    const dayStart = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
    const dayEnd   = dayStart + 86400000;
    const rev = DB.orders
      .filter(o => o.status === 'completed' && o.createdAt >= dayStart && o.createdAt < dayEnd)
      .reduce((s, o) => s + (parseInt(o.total) || 0), 0);
    data.push(rev);
  }

  const ctx = document.getElementById('sales-chart');
  if (!ctx) return;
  if (salesChart) salesChart.destroy();

  salesChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Revenue (₹)',
        data,
        backgroundColor: 'rgba(255,109,0,0.15)',
        borderColor:     '#FF6D00',
        borderWidth:     2,
        borderRadius:    8,
        hoverBackgroundColor: 'rgba(255,109,0,0.35)'
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend:{ display:false } },
      scales: {
        y: { beginAtZero:true, grid:{ color:'rgba(0,0,0,0.04)' }, ticks:{ callback:v=>'₹'+v.toLocaleString('en-IN') } },
        x: { grid:{ display:false } }
      }
    }
  });
}

function renderStatusChart() {
  const counts = {
    Placed:    DB.orders.filter(o => o.status === 'placed').length,
    Cooking:   DB.orders.filter(o => o.status === 'cooking').length,
    'Out':     DB.orders.filter(o => o.status === 'out_for_delivery').length,
    Done:      DB.orders.filter(o => o.status === 'completed').length,
    Cancelled: DB.orders.filter(o => o.status === 'cancelled').length
  };
  const ctx2 = document.getElementById('status-chart');
  if (!ctx2) return;
  if (statusChart) statusChart.destroy();
  statusChart = new Chart(ctx2, {
    type: 'doughnut',
    data: {
      labels: Object.keys(counts),
      datasets: [{ data: Object.values(counts), backgroundColor: ['#FF6D00','#2979FF','#AB47BC','#00C853','#FF3D57'], borderWidth:0, hoverOffset:8 }]
    },
    options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } } }
  });
}

window.switchChart = (mode, el) => {
  chartMode = mode;
  document.querySelectorAll('.a-tab').forEach(x => x.classList.remove('active'));
  el.classList.add('active');
  renderSalesChart();
};

// ══════════════════════════════════════
//  MENU UI
// ══════════════════════════════════════
function renderMenuUI(filter = '') {
  const tb = document.querySelector('#item-list tbody');
  if (!tb) return;
  const items = filter
    ? DB.items.filter(i => i.name.toLowerCase().includes(filter.toLowerCase()) || (i.category||'').toLowerCase().includes(filter.toLowerCase()))
    : DB.items;

  if (!items.length) {
    tb.innerHTML = `<tr><td colspan="5"><div class="empty-state"><i class="fa-solid fa-utensils"></i><p>No dishes found</p></div></td></tr>`;
    return;
  }

  tb.innerHTML = items.map(i => `
    <tr>
      <td>
        <div style="display:flex;gap:10px;align-items:center;">
          <img src="${xss(i.image)}" style="width:38px;height:38px;border-radius:8px;object-fit:cover;border:1px solid #F0F0F0;" onerror="this.src='https://via.placeholder.com/38'">
          <div>
            <div style="font-weight:700;">${xss(i.name)}</div>
            ${i.unitType ? `<span class="unit-tag">${xss(i.unitVal)}${xss(i.unitType)}</span>` : ''}
          </div>
        </div>
      </td>
      <td><span class="badge bg-cook">${xss(i.category)}</span></td>
      <td style="font-weight:800;color:var(--brand);">₹${xss(i.price)}</td>
      <td>
        <span style="font-size:0.8rem;font-weight:700;color:${parseInt(i.stock)>10?'var(--success)':'var(--danger)'};">
          ${xss(i.stock)} left
        </span>
      </td>
      <td style="white-space:nowrap;">
        <button class="btn b-info b-xs"  onclick="viewProd('${i.id}')"  title="Preview"><i class="fa-solid fa-eye"></i></button>
        <button class="btn b-dark b-xs"  onclick="editItem('${i.id}')"  title="Edit" style="margin:0 4px;"><i class="fa-solid fa-pen"></i></button>
        <button class="btn b-xs" style="background:#FFEBEE;color:var(--danger);" onclick="del('menu/${i.id}')" title="Delete"><i class="fa-solid fa-trash"></i></button>
      </td>
    </tr>
  `).join('');
}

window.filterMenu = (val) => renderMenuUI(val);

function renderCatUI() {
  const list   = document.getElementById('cat-list');
  const iCat   = document.getElementById('i-cat');
  const cpCat  = document.getElementById('cp-cat');

  if (list) list.innerHTML = DB.cats.map(c => `
    <div style="display:flex;justify-content:space-between;align-items:center;background:#FAFAFA;padding:10px 14px;border-radius:10px;border:1px solid #F0F0F0;margin-bottom:8px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <img src="${xss(c.image)}" style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid white;box-shadow:var(--shadow);" onerror="this.src='https://via.placeholder.com/38'">
        <span style="font-weight:700;">${xss(c.name)}</span>
      </div>
      <div style="display:flex;gap:8px;">
        <button class="btn b-ghost b-xs" onclick="editCat('${c.id}')"><i class="fa-solid fa-pen"></i></button>
        <button class="btn b-xs" style="background:#FFEBEE;color:var(--danger);" onclick="del('categories/${c.id}')"><i class="fa-solid fa-trash"></i></button>
      </div>
    </div>
  `).join('');

  if (iCat) iCat.innerHTML = DB.cats.map(c => `<option value="${xss(c.name)}">${xss(c.name)}</option>`).join('');
  if (cpCat) cpCat.innerHTML = '<option value="">All Menu (Global)</option>' + DB.cats.map(c => `<option value="${xss(c.name)}">${xss(c.name)}</option>`).join('');
}

// ══════════════════════════════════════
//  ORDERS UI
// ══════════════════════════════════════
function renderOrdersUI() {
  const tb = document.querySelector('#order-list tbody');
  if (!tb) return;

  const filtered = currentOrderFilter === 'all'
    ? DB.orders
    : DB.orders.filter(o => o.status === currentOrderFilter);

  if (!filtered.length) {
    tb.innerHTML = `<tr><td colspan="8"><div class="empty-state"><i class="fa-solid fa-clipboard-list"></i><p>No orders in this category</p></div></td></tr>`;
    return;
  }

  const statusMap = { placed:'bg-new', cooking:'bg-cook', out_for_delivery:'bg-out', completed:'bg-done', cancelled:'bg-can' };

  tb.innerHTML = filtered.map(o => {
    const cls        = statusMap[o.status] || 'bg-new';
    const payIcon    = o.paymentMode === 'Online' ? '💳' : '💵';
    const itemCount  = (o.items||[]).length;
    const confirmedBadge = o.userConfirmed ? '<i class="fa-solid fa-circle-check" style="color:var(--success);font-size:0.85rem;" title="User confirmed delivery"></i> ' : '';
    const timeAgo    = o.createdAt ? formatTimeAgo(o.createdAt) : '--';

    let driverInfo = '';
    if (o.driverName) {
      const is3rd = o.deliveryProvider && o.deliveryProvider !== 'Internal';
      driverInfo = is3rd
        ? `<div style="font-size:0.7rem;color:#7B1FA2;margin-top:3px;">📦 ${xss(o.deliveryProvider)}: ${xss(o.driverName)}</div>`
        : `<div style="font-size:0.7rem;color:var(--brand);margin-top:3px;">🛵 Staff: ${xss(o.driverName)}</div>`;
    }

    return `<tr>
      <td><b style="font-size:0.88rem;">#${xss(o.id.slice(-4).toUpperCase())}</b></td>
      <td>
        <div style="font-weight:700;">${confirmedBadge}${xss(o.userName)}</div>
        <div style="font-size:0.72rem;color:var(--text-muted);">${xss(o.userPhone||'')}</div>
      </td>
      <td style="font-size:0.78rem;">${itemCount} item${itemCount !== 1 ? 's' : ''}</td>
      <td style="font-weight:800;color:var(--brand);">₹${xss(o.total)}</td>
      <td>${payIcon} ${xss(o.paymentMode||'COD')}</td>
      <td>
        <span class="badge ${cls}">${xss(o.status.replace(/_/g,' '))}</span>
        ${driverInfo}
      </td>
      <td style="font-size:0.72rem;color:var(--text-muted);">${timeAgo}</td>
      <td>
        <button class="btn b-prim b-xs" onclick="manageOrder('${o.id}')"><i class="fa-solid fa-gears"></i> Manage</button>
      </td>
    </tr>`;
  }).join('');
}

window.filterOrders = (status, el) => {
  currentOrderFilter = status;
  document.querySelectorAll('[id^="f-"]').forEach(b => {
    b.className = 'btn b-sm b-ghost';
  });
  el.style.background = 'var(--dark)'; el.style.color = 'white';
  renderOrdersUI();
};

function formatTimeAgo(ts) {
  const diff = Date.now() - ts;
  if (diff < 60000)   return `${Math.floor(diff/1000)}s ago`;
  if (diff < 3600000) return `${Math.floor(diff/60000)}m ago`;
  return `${Math.floor(diff/3600000)}h ago`;
}

// ══════════════════════════════════════
//  CUSTOMERS UI
// ══════════════════════════════════════
function renderCustomersUI(filter = '') {
  const tb = document.querySelector('#customer-list-table tbody');
  if (!tb) return;
  const list = filter
    ? DB.customers.filter(c => (c.name||'').toLowerCase().includes(filter.toLowerCase()) || (c.phone||'').includes(filter))
    : DB.customers;

  tb.innerHTML = list.map(c => `
    <tr>
      <td style="font-weight:700;">${xss(c.name)}</td>
      <td>${xss(c.phone)||'—'}</td>
      <td style="font-size:0.82rem;">${xss(c.email)||'—'}</td>
      <td>${c.totalOrders||0}</td>
      <td style="color:var(--success);font-weight:700;">₹${(c.totalSpent||0).toLocaleString('en-IN')}</td>
      <td style="font-size:0.75rem;color:var(--text-muted);">${c.createdAt ? new Date(c.createdAt).toLocaleDateString('en-IN') : '—'}</td>
    </tr>
  `).join('') || `<tr><td colspan="6"><div class="empty-state"><i class="fa-solid fa-users"></i><p>No customers found</p></div></td></tr>`;
}

window.filterCustomers = (val) => renderCustomersUI(val);

// ══════════════════════════════════════
//  VIP CRM UI
// ══════════════════════════════════════
function renderLoyaltyUI(filter = '') {
  const tb = document.querySelector('#loyalty-list-table tbody');
  if (!tb) return;

  let vips = DB.customers
    .filter(c => (c.totalOrders || 0) > 0)
    .sort((a, b) => (b.totalSpent || 0) - (a.totalSpent || 0));

  if (filter) vips = vips.filter(c => (c.name||'').toLowerCase().includes(filter.toLowerCase()));

  const gold = vips.filter(c => (c.totalSpent || 0) > 5000).length;
  const gc   = document.getElementById('vip-gold-count');
  if (gc) gc.innerText = gold;

  tb.innerHTML = vips.map(c => {
    const spent = c.totalSpent || 0;
    const orders = c.totalOrders || 0;
    let lvl = 'BRONZE', badgeCls = 'bg-new', icon = '🥉';
    if (spent > 5000) { lvl = 'GOLD VIP'; badgeCls = 'bg-gold'; icon = '👑'; }
    else if (spent > 2000) { lvl = 'SILVER'; badgeCls = 'bg-info'; icon = '🥈'; }
    const lastOrder = c.lastOrderAt ? formatTimeAgo(c.lastOrderAt) : '—';

    return `<tr>
      <td>
        <div style="font-weight:700;">${icon} ${xss(c.name)}</div>
        <div style="font-size:0.72rem;color:var(--text-muted);">${xss(c.phone||c.email||'')}</div>
      </td>
      <td><b>${orders}</b></td>
      <td style="color:var(--success);font-weight:800;">₹${spent.toLocaleString('en-IN')}</td>
      <td><span class="badge ${badgeCls}">${lvl}</span></td>
      <td style="font-size:0.78rem;color:var(--text-muted);">${lastOrder}</td>
      <td style="white-space:nowrap;">
        <button class="btn b-dark b-xs" onclick="viewVipHistory('${c.id}','${xss(c.name)}')" style="margin-right:4px;"><i class="fa-solid fa-clock-rotate-left"></i></button>
        <button class="btn b-gold b-xs" onclick="openVipOffer('${xss(c.fcmToken||'')}','${xss(c.name)}')"><i class="fa-solid fa-gift"></i></button>
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="6"><div class="empty-state"><i class="fa-solid fa-crown"></i><p>No VIP customers yet</p></div></td></tr>`;
}

window.filterVip = (val) => renderLoyaltyUI(val);

window.viewVipHistory = (uid, name) => {
  document.getElementById('vip-hist-name').innerText = name + "'s Order History";
  const cnt = document.getElementById('vip-hist-content');
  cnt.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-muted);"><span class="spinner" style="border-color:rgba(0,0,0,0.15);border-top-color:var(--brand);"></span></div>';
  openModal('m-vip-history');

  const q = query(ref(db, 'orders'), orderByChild('userId'), equalTo(uid));
  get(q).then(snap => {
    if (!snap.exists()) { cnt.innerHTML = '<div class="empty-state"><i class="fa-solid fa-box-open"></i><p>No orders found</p></div>'; return; }
    const list = Object.values(snap.val()).sort((a,b) => b.createdAt - a.createdAt);
    cnt.innerHTML = list.map(o => {
      const itemsTxt = (o.items||[]).map(i => `${i.qty}× ${xss(i.name)}`).join(', ');
      const statusMap = { placed:'bg-new', cooking:'bg-cook', out_for_delivery:'bg-out', completed:'bg-done', cancelled:'bg-can' };
      return `<div class="hist-item">
        <div>
          <div style="font-size:0.72rem;color:var(--text-muted);">${o.createdAt ? new Date(o.createdAt).toLocaleString('en-IN') : ''} &nbsp;|&nbsp; #${o.id.slice(-4).toUpperCase()}</div>
          <div style="font-weight:600;font-size:0.85rem;margin-top:3px;">${itemsTxt}</div>
          <span class="badge ${statusMap[o.status]||'bg-new'}" style="margin-top:5px;">${xss(o.status.replace(/_/g,' '))}</span>
        </div>
        <div style="font-weight:800;color:var(--brand);white-space:nowrap;">₹${xss(o.total)}</div>
      </div>`;
    }).join('');
  }).catch(() => { cnt.innerHTML = '<p style="color:var(--danger);">Error loading history. Check Firebase rules.</p>'; });
};

window.openVipOffer = (token, name) => {
  if (!token || token === 'undefined' || token.length < 10) {
    showToast("Customer doesn't have the app installed (no FCM token)", "error"); return;
  }
  document.getElementById('vip-offer-name').innerText  = name;
  document.getElementById('vip-offer-token').value     = token;
  document.getElementById('vip-offer-title').value     = '';
  document.getElementById('vip-offer-msg').value       = '';
  openModal('m-vip-offer');
};

window.sendVipOffer = () => {
  const token = document.getElementById('vip-offer-token').value;
  const title = document.getElementById('vip-offer-title').value.trim();
  const msg   = document.getElementById('vip-offer-msg').value.trim();
  if (!title || !msg) { showToast("Title and message required!", "error"); return; }
  sendPushNotification(token, title, msg);
  showToast("Exclusive VIP offer sent! 🎁", "success");
  secLog('ok', `VIP offer sent: "${title}"`);
  closeModal('m-vip-offer');
};

// ══════════════════════════════════════
//  REVIEWS UI
// ══════════════════════════════════════
function renderReviewsUI() {
  const tb = document.querySelector('#review-list-table tbody');
  if (!tb) return;
  const all = [];
  Object.keys(DB.reviews).forEach(pid => {
    const prod = DB.items.find(x => x.id === pid) || { name: 'Deleted Item' };
    Object.keys(DB.reviews[pid]).forEach(rid => {
      all.push({ id:rid, prodId:pid, prodName:prod.name, ...DB.reviews[pid][rid] });
    });
  });
  all.sort((a, b) => (b.timestamp||0) - (a.timestamp||0));

  tb.innerHTML = all.map(r => {
    const stars = Array(5).fill(0).map((_,i) => `<i class="fa-solid fa-star ${i < r.rating ? 'star-gold' : 'star-gray'}"></i>`).join('');
    const typeBadge = r.isAdminAdded ? '<span class="badge bg-new">ADMIN</span>' : '<span class="badge bg-cook">REAL</span>';
    const platBadge = r.platform ? `<span class="device-badge">${xss(r.platform)}</span>` : '';
    return `<tr>
      <td style="font-weight:700;font-size:0.85rem;">${xss(r.prodName)}</td>
      <td>${xss(r.userName)}<br>${platBadge}</td>
      <td><div class="stars-row">${stars}</div></td>
      <td style="font-size:0.82rem;max-width:180px;" class="ellipsis">${xss(r.comment)}</td>
      <td>${typeBadge}</td>
      <td style="font-size:0.72rem;color:var(--text-muted);">${r.timestamp ? new Date(r.timestamp).toLocaleDateString('en-IN') : '—'}</td>
      <td style="white-space:nowrap;">
        <button class="btn b-dark b-xs" onclick="editReview('${r.prodId}','${r.id}')" style="margin-right:4px;"><i class="fa-solid fa-pen"></i></button>
        <button class="btn b-xs" style="background:#FFEBEE;color:var(--danger);" onclick="del('reviews/${r.prodId}/${r.id}')"><i class="fa-solid fa-trash"></i></button>
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-star"></i><p>No reviews yet</p></div></td></tr>`;
}

// ══════════════════════════════════════
//  DRIVERS UI
// ══════════════════════════════════════
function renderDriversUI() {
  const tb = document.querySelector('#driver-list tbody');
  if (!tb) return;
  const active = DB.drivers.filter(d => d.approved && !d.blocked).length;
  const dc = document.getElementById('driver-count');
  if (dc) dc.innerText = `${active} active`;

  tb.innerHTML = DB.drivers.map(d => {
    let statusBadge = d.blocked
      ? '<span class="badge bg-can">Blocked</span>'
      : (d.approved ? '<span class="badge bg-done">Active</span>' : '<span class="badge bg-new">Pending</span>');
    const deliveries = d.totalDeliveries || 0;
    return `<tr>
      <td style="font-weight:700;">${xss(d.name)}</td>
      <td>${xss(d.phone)}</td>
      <td>${statusBadge}</td>
      <td style="font-weight:700;">${deliveries}</td>
      <td style="white-space:nowrap;">
        ${!d.approved ? `<button class="btn b-succ b-xs" onclick="updDriver('${d.id}',{approved:true})" style="margin-right:4px;"><i class="fa-solid fa-check"></i> Approve</button>` : ''}
        ${d.approved && !d.blocked ? `<button class="btn b-dang b-xs" onclick="updDriver('${d.id}',{blocked:true})" style="margin-right:4px;"><i class="fa-solid fa-ban"></i> Block</button>` : ''}
        ${d.blocked ? `<button class="btn b-succ b-xs" onclick="updDriver('${d.id}',{blocked:false})"><i class="fa-solid fa-lock-open"></i> Unblock</button>` : ''}
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="5"><div class="empty-state"><i class="fa-solid fa-motorcycle"></i><p>No drivers added yet</p></div></td></tr>`;
}

// ══════════════════════════════════════
//  MARKETING UI
// ══════════════════════════════════════
function renderMarketingUI() {
  // Banners
  const banList = document.getElementById('ban-list');
  if (banList) {
    banList.innerHTML = DB.banners.map(b => `
      <div class="ban-card">
        <img src="${xss(b.image)}" onerror="this.src='https://via.placeholder.com/200x88'">
        <button class="ban-del" onclick="del('sliders/${b.id}')"><i class="fa-solid fa-trash"></i></button>
      </div>
    `).join('') || '<p class="text-sm" style="color:var(--text-muted);">No banners yet. Add one!</p>';
  }

  // Coupons
  const coupList = document.getElementById('coup-list');
  if (coupList) {
    coupList.innerHTML = DB.coupons.map(c => {
      const catTag = c.category ? `<span style="font-size:0.68rem;background:#EDE9FE;color:#5B21B6;padding:2px 6px;border-radius:4px;margin-left:6px;">${xss(c.category)}</span>` : '';
      return `<div class="coup-item">
        <div>
          <b style="font-family:'Syne',sans-serif;">${xss(c.id)}</b>
          <span class="badge bg-done" style="margin-left:6px;">${c.type==='flat'?'₹':'%'}${xss(c.value)} OFF</span>
          ${catTag}
          <div class="text-sm">Min: ₹${xss(c.minOrder)||0} ${c.expiry?'• Exp: '+xss(c.expiry):''}</div>
        </div>
        <button class="btn b-xs" style="background:#FFEBEE;color:var(--danger);" onclick="del('coupons/${c.id}')"><i class="fa-solid fa-trash"></i></button>
      </div>`;
    }).join('') || '<p class="text-sm" style="color:var(--text-muted);">No active coupons.</p>';
  }
}

// ══════════════════════════════════════
//  PUSH NOTIFICATIONS (FCM Legacy API)
// ══════════════════════════════════════
window.sendPushNotification = async (token, title, body) => {
  if (!token || !FCM_KEY) return;
  try {
    await fetch('https://fcm.googleapis.com/fcm/send', {
      method: 'POST',
      headers: { 'Content-Type':'application/json', 'Authorization':'key=' + FCM_KEY },
      body: JSON.stringify({
        to: token,
        notification: { title, body, icon:'https://cdn-icons-png.flaticon.com/512/732/732200.png', click_action:'FLUTTER_NOTIFICATION_CLICK' },
        data: { type:'offer', click_action:'FLUTTER_NOTIFICATION_CLICK' }
      })
    });
  } catch (e) { console.warn('FCM send failed:', e); }
};

window.sendBroadcast = () => {
  const title = document.getElementById('br-title').value.trim();
  const body  = document.getElementById('br-msg').value.trim();
  if (!title || !body) { showToast("Title and message required!", "error"); return; }

  showToast("Sending broadcast...", "info");
  get(ref(db, 'customers')).then(snap => {
    const users = snap.val() || {};
    let sent = 0;
    Object.values(users).forEach(u => {
      if (u.fcmToken) { sendPushNotification(u.fcmToken, title, body); sent++; }
    });
    showToast(`Broadcast sent to ${sent} devices! 🚀`, "success");
    secLog('ok', `Broadcast sent: "${title}" → ${sent} devices`);
    closeModal('m-broadcast');
  });
};

// ══════════════════════════════════════
//  ORDER MANAGE
// ══════════════════════════════════════
window.manageOrder = (oid) => {
  const o = DB.orders.find(x => x.id === oid);
  if (!o) { showToast("Order not found", "error"); return; }

  const driverOpts = DB.drivers
    .filter(d => d.approved && !d.blocked)
    .map(d => `<option value="${d.id}">${xss(d.name)} (${xss(d.phone)})</option>`)
    .join('');

  const payInfo = o.paymentMode === 'Online'
    ? `<span style="color:var(--success);font-weight:800;"><i class="fa-solid fa-shield-check"></i> PAID ONLINE ${o.paymentId ? '('+xss(o.paymentId)+')' : ''}</span>`
    : `<span style="color:var(--warn);font-weight:800;"><i class="fa-solid fa-money-bill-wave"></i> Cash on Delivery</span>`;

  document.getElementById('k-order-body').innerHTML = `
    <div style="background:#FAFAFA;padding:16px;border-radius:12px;border:1px solid #F0F0F0;margin-bottom:16px;">
      <div class="flex-between">
        <div>
          <div style="font-weight:800;font-size:1rem;">${xss(o.userName)}</div>
          <div style="font-size:0.8rem;color:var(--text-muted);">${xss(o.userPhone||'')}</div>
        </div>
        <a href="tel:${xss(o.userPhone)}" class="btn b-succ b-sm"><i class="fa-solid fa-phone"></i> Call</a>
      </div>
      <div style="font-size:0.82rem;color:#555;margin-top:8px;"><i class="fa-solid fa-location-dot" style="color:var(--brand);"></i> ${xss(o.address)}</div>
      <div style="margin-top:10px;padding:10px;background:white;border-radius:8px;border:1px dashed #DDD;font-size:0.85rem;">
        ${payInfo}
      </div>
      <div style="border-top:1px dashed #DDD;margin-top:12px;padding-top:10px;">
        ${(o.items||[]).map(i => `<div style="display:flex;justify-content:space-between;margin-bottom:4px;font-size:0.88rem;"><span>${i.qty}× ${xss(i.name)}</span><span>₹${(i.price*i.qty)}</span></div>`).join('')}
        <div style="display:flex;justify-content:space-between;margin-top:8px;padding-top:8px;border-top:1px solid #F0F0F0;font-size:0.8rem;color:var(--text-muted);">
          <span>Subtotal</span><span>₹${xss(o.subTotal||o.total)}</span>
        </div>
        ${o.deliveryFee>0?`<div style="display:flex;justify-content:space-between;font-size:0.8rem;color:var(--text-muted);"><span>Delivery</span><span>₹${xss(o.deliveryFee)}</span></div>`:''}
        ${(o.discount||0)>0?`<div style="display:flex;justify-content:space-between;font-size:0.8rem;color:var(--success);"><span>Discount</span><span>-₹${xss(o.discount)}</span></div>`:''}
        <div style="display:flex;justify-content:space-between;font-weight:800;font-size:1.1rem;margin-top:6px;"><span>TOTAL</span><span style="color:var(--brand);">₹${xss(o.total)}</span></div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px;">
      <button class="btn b-wa b-sm" onclick="shareWhatsApp('${o.id}')"><i class="fa-brands fa-whatsapp"></i> WhatsApp Bill</button>
      <button class="btn b-dark b-sm" onclick="printBill('${o.id}')"><i class="fa-solid fa-print"></i> Print Receipt</button>
    </div>

    <h4 style="margin-bottom:10px;font-family:'Syne',sans-serif;">Update Status</h4>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;">
      <button class="btn b-xs" style="background:#E3F2FD;color:#1565C0;" onclick="updStatus('${o.id}','cooking','${o.userId||''}')">👨‍🍳 Cooking</button>
      <button class="btn b-xs" style="background:#F3E5F5;color:#6A1B9A;" onclick="updStatus('${o.id}','out_for_delivery','${o.userId||''}')">🛵 Out for Delivery</button>
      <button class="btn b-succ b-xs" onclick="updStatus('${o.id}','completed','${o.userId||''}')">✅ Delivered/Done</button>
      <button class="btn b-dang b-xs" onclick="updStatus('${o.id}','cancelled','${o.userId||''}')">❌ Cancel</button>
    </div>

    <h4 style="margin-bottom:10px;font-family:'Syne',sans-serif;">Assign Delivery</h4>
    <div class="driver-tabs">
      <div id="tab-internal-${o.id}" class="d-tab active" onclick="setDeliveryMode('internal','${o.id}')">Internal Staff</div>
      <div id="tab-external-${o.id}" class="d-tab" onclick="setDeliveryMode('external','${o.id}')">3rd Party (Porter etc.)</div>
    </div>
    <div id="view-internal-${o.id}" style="display:flex;gap:8px;align-items:center;">
      <select id="sel-drv-${o.id}" class="inp" style="margin:0;flex:1;"><option value="">Select Driver...</option>${driverOpts}</select>
      <button class="btn b-prim b-sm" onclick="assignDriver('${o.id}','${o.userId||''}')">Assign</button>
    </div>
    <div id="view-external-${o.id}" style="display:none;background:#FFF8E1;padding:16px;border-radius:10px;border:1px solid #FFE082;">
      <label class="lbl">Provider (e.g. Porter)</label>
      <input type="text" id="ext-prov-${o.id}" class="inp" value="Porter">
      <div class="inp-grp">
        <div><label class="lbl">Driver Name</label><input type="text" id="ext-name-${o.id}" class="inp" placeholder="Name"></div>
        <div><label class="lbl">Driver Phone</label><input type="number" id="ext-phone-${o.id}" class="inp" placeholder="98XXXXXXXX"></div>
      </div>
      <label class="lbl">Tracking URL (optional)</label>
      <input type="text" id="ext-link-${o.id}" class="inp" placeholder="https://porter.in/track/...">
      <button class="btn b-prim b-sm" style="width:100%;" onclick="assignExternal('${o.id}','${o.userId||''}')">Assign 3rd Party Driver</button>
    </div>
  `;
  openModal('m-order');
};

window.setDeliveryMode = (mode, oid) => {
  document.getElementById(`tab-internal-${oid}`).classList.toggle('active', mode === 'internal');
  document.getElementById(`tab-external-${oid}`).classList.toggle('active', mode === 'external');
  document.getElementById(`view-internal-${oid}`).style.display = mode === 'internal' ? 'flex' : 'none';
  document.getElementById(`view-external-${oid}`).style.display = mode === 'external' ? 'block' : 'none';
};

window.updStatus = (oid, st, uid) => {
  update(ref(db, 'orders/'+oid), { status:st }).then(() => {
    showToast(`Status → ${st.replace(/_/g,' ').toUpperCase()}`, "success");
    if (st === 'cooking')          sendPushNotification(uid, "Kitchen Update 👨‍🍳", "Your prasadam is being lovingly prepared!");
    if (st === 'out_for_delivery') sendPushNotification(uid, "Out for Delivery 🛵", "Your order is on the way! Track it now.");
    if (st === 'completed')        sendPushNotification(uid, "Delivered! ✅", "Hare Krishna! Thank you for serving Govinda. 🙏");
    if (st === 'cancelled')        sendPushNotification(uid, "Order Cancelled ❌", "Your order was cancelled. Contact us for help.");
    // Update driver delivery count
    const o = DB.orders.find(x => x.id === oid);
    if (st === 'completed' && o?.driverId && o.driverId !== 'EXTERNAL') {
      const d = DB.drivers.find(x => x.id === o.driverId);
      if (d) update(ref(db, 'deliveryPartners/'+o.driverId), { totalDeliveries:(d.totalDeliveries||0)+1 });
    }
    closeModal('m-order');
  });
};

window.assignDriver = (oid, uid) => {
  const did = document.getElementById('sel-drv-'+oid).value;
  if (!did) { showToast("Please select a driver first!", "error"); return; }
  const d = DB.drivers.find(x => x.id === did);
  update(ref(db,'orders/'+oid), { driverId:did, driverName:d.name, driverPhone:d.phone, deliveryProvider:'Internal', status:'out_for_delivery' })
    .then(() => { sendPushNotification(uid, "Driver Assigned 🛵", `${d.name} is coming to deliver your order!`); showToast("Staff driver assigned!", "success"); closeModal('m-order'); });
};

window.assignExternal = (oid, uid) => {
  const provider = document.getElementById('ext-prov-'+oid).value || 'External';
  const dName    = document.getElementById('ext-name-'+oid).value.trim();
  if (!dName) { showToast("Driver name required!", "error"); return; }
  update(ref(db,'orders/'+oid), {
    driverId:'EXTERNAL', driverName:dName,
    driverPhone:document.getElementById('ext-phone-'+oid).value||'',
    deliveryProvider:provider,
    trackingUrl:document.getElementById('ext-link-'+oid).value||'',
    status:'out_for_delivery'
  }).then(() => {
    sendPushNotification(uid, `On The Way (${provider}) 🛵`, `${provider} driver ${dName} is bringing your prasadam!`);
    showToast(`${provider} driver assigned!`, "success");
    closeModal('m-order');
  });
};

// ══════════════════════════════════════
//  WHATSAPP BILL
// ══════════════════════════════════════
window.shareWhatsApp = (oid) => {
  const o = DB.orders.find(x => x.id === oid);
  if (!o) return;
  const items = (o.items||[]).map(i => `  ▪ ${i.qty} × ${i.name} = ₹${i.price * i.qty}`).join('\n');
  const txt = `*🙏 Hare Krishna! — Govinda's Prasadam*\n\nDear *${o.userName}*, thank you for your divine order!\n\n📦 *Order #${o.id.slice(-4).toUpperCase()}*\n📅 ${o.createdAt ? new Date(o.createdAt).toLocaleString('en-IN') : ''}\n\n🛒 *Order Details:*\n${items}\n\n────────────────────\n💵 Subtotal: ₹${o.subTotal||o.total}\n🚚 Delivery: ₹${o.deliveryFee||0}${(o.discount||0)>0?'\n🎁 Discount: -₹'+o.discount:''}\n💰 *TOTAL: ₹${o.total}*\n────────────────────\n\n📍 *Delivery Address:*\n${o.address}\n\n💳 *Payment:* ${o.paymentMode === 'Online' ? 'Online Paid ✅' : 'Cash on Delivery 💵'}\n\n*Hare Krishna! 🙏 Govinda's ISKCON Hadapsar*`;
  window.open(`https://wa.me/91${o.userPhone}?text=${encodeURIComponent(txt)}`, '_blank');
};

// ══════════════════════════════════════
//  PRINT BILL
// ══════════════════════════════════════
window.printBill = (oid) => {
  const o = DB.orders.find(x => x.id === oid);
  if (!o) return;
  document.getElementById('inv-id').innerText   = '#' + o.id.slice(-4).toUpperCase();
  document.getElementById('inv-name').innerText = o.userName;
  document.getElementById('inv-date').innerText = o.createdAt ? new Date(o.createdAt).toLocaleString('en-IN') : '';
  const tb = document.getElementById('inv-items');
  tb.innerHTML = (o.items||[]).map(i => `<tr><td>${i.qty}× ${xss(i.name)}</td><td style="text-align:right;">${i.price*i.qty}</td></tr>`).join('');
  document.getElementById('inv-sub').innerText  = `Sub: ₹${o.subTotal||o.total}`;
  document.getElementById('inv-del').innerText  = `Del: ₹${o.deliveryFee||0}`;
  document.getElementById('inv-disc').innerText = `Disc: -₹${o.discount||0}`;
  document.getElementById('inv-total').innerText = '₹' + o.total;
  window.print();
};

// ══════════════════════════════════════
//  MENU ITEM CRUD
// ══════════════════════════════════════
window.openAddItemModal = () => {
  document.getElementById('item-modal-title').innerText = 'Add New Dish';
  document.getElementById('i-id').value = '';
  ['i-name','i-price','i-desc','i-img','i-img-1','i-img-2','i-img-3','i-unit-val'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  const stk = document.getElementById('i-stk'); if (stk) stk.value = '50';
  const ut  = document.getElementById('i-unit-type'); if (ut) ut.value = '';
  const ft  = document.getElementById('i-featured'); if (ft) ft.value = 'false';
  openModal('m-item');
};

window.openCatModal = () => {
  document.getElementById('cat-modal-title').innerText = 'New Category';
  document.getElementById('c-id').value = '';
  document.getElementById('c-name').value = '';
  document.getElementById('c-img').value = '';
  openModal('m-cat');
};

window.editCat = (id) => {
  const c = DB.cats.find(x => x.id === id); if (!c) return;
  document.getElementById('cat-modal-title').innerText = 'Edit Category';
  document.getElementById('c-id').value   = id;
  document.getElementById('c-name').value = c.name;
  document.getElementById('c-img').value  = c.image || '';
  openModal('m-cat');
};

window.saveCat = () => {
  const id  = document.getElementById('c-id').value.trim();
  const n   = document.getElementById('c-name').value.trim();
  const img = document.getElementById('c-img').value.trim();
  if (!n) { showToast("Category name required!", "error"); return; }
  const finalId = id || n.toLowerCase().replace(/\s+/g,'_').replace(/[^a-z0-9_]/g,'');
  update(ref(db, 'categories/'+finalId), { name:n, image:img, active:true })
    .then(() => { showToast(id ? "Category updated!" : "Category created!", "success"); closeModal('m-cat'); });
};

window.editItem = (id) => {
  const i = DB.items.find(x => x.id === id); if (!i) return;
  document.getElementById('item-modal-title').innerText = 'Edit: ' + i.name;
  document.getElementById('i-id').value       = i.id;
  document.getElementById('i-name').value     = i.name;
  document.getElementById('i-cat').value      = i.category;
  document.getElementById('i-price').value    = i.price;
  document.getElementById('i-desc').value     = i.description || '';
  document.getElementById('i-stk').value      = i.stock || 0;
  document.getElementById('i-unit-type').value = i.unitType || '';
  document.getElementById('i-unit-val').value  = i.unitVal || '';
  document.getElementById('i-featured').value  = String(i.featured || 'false');
  const gal = i.gallery || [i.image];
  document.getElementById('i-img').value   = gal[0] || '';
  document.getElementById('i-img-1').value = gal[1] || '';
  document.getElementById('i-img-2').value = gal[2] || '';
  document.getElementById('i-img-3').value = gal[3] || '';
  openModal('m-item');
};

window.saveItem = () => {
  const id      = document.getElementById('i-id').value;
  const finalId = id || push(ref(db,'menu')).key;
  const name    = document.getElementById('i-name').value.trim();
  const mainImg = document.getElementById('i-img').value.trim();
  if (!name)    { showToast("Dish name required!", "error"); return; }
  if (!mainImg) { showToast("Primary image URL required!", "error"); return; }

  const price    = parseInt(document.getElementById('i-price').value)    || 0;
  const stock    = parseInt(document.getElementById('i-stk').value)      || 0;
  const unitVal  = parseInt(document.getElementById('i-unit-val').value) || null;
  const featured = document.getElementById('i-featured').value === 'true';

  const gal = [mainImg,
    document.getElementById('i-img-1').value,
    document.getElementById('i-img-2').value,
    document.getElementById('i-img-3').value
  ].filter(u => u && u.startsWith('http'));

  const payload = {
    name, category:document.getElementById('i-cat').value,
    price, description:document.getElementById('i-desc').value.trim(),
    image:mainImg, gallery:gal, stock, unitType:document.getElementById('i-unit-type').value,
    unitVal, featured, active:true
  };
  // Remove null/undefined values
  Object.keys(payload).forEach(k => (payload[k] === null || payload[k] === undefined) && delete payload[k]);

  update(ref(db,'menu/'+finalId), payload)
    .then(() => { showToast(id ? "Dish updated!" : "Dish added!", "success"); closeModal('m-item'); })
    .catch(e  => { console.error(e); showToast("Failed to save dish: " + e.message, "error"); });
};

window.viewProd = (id) => {
  const i = DB.items.find(x => x.id === id); if (!i) return;
  const gal  = i.gallery || [i.image];
  const thumbs = gal.map((url, idx) => `<img src="${xss(url)}" class="thumb-img ${idx===0?'active-thumb':''}" onclick="switchThumb('${xss(url)}',this)">`).join('');
  document.getElementById('pv-content').innerHTML = `
    <img src="${xss(gal[0])}" id="p-main" class="prev-main-img" onerror="this.src='https://via.placeholder.com/400x200'">
    ${gal.length > 1 ? `<div class="thumb-row">${thumbs}</div>` : ''}
    <h2 style="margin-top:14px;font-family:'Syne',sans-serif;">${xss(i.name)}</h2>
    <h3 style="color:var(--brand);margin-top:4px;">₹${xss(i.price)}</h3>
    <p style="font-size:0.88rem;color:#555;margin-top:8px;">${xss(i.description)||'No description available'}</p>
    <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
      <span class="unit-tag">${xss(i.category)}</span>
      ${i.unitType ? `<span class="unit-tag" style="background:#EDE9FE;color:#5B21B6;">${xss(i.unitVal)}${xss(i.unitType)}</span>` : ''}
      ${i.featured ? '<span class="unit-tag" style="background:#FEF3C7;color:#92400E;">⭐ Featured</span>' : ''}
      <span class="unit-tag" style="background:${parseInt(i.stock)>0?'#E8F5E9':'#FFEBEE'};color:${parseInt(i.stock)>0?'var(--success)':'var(--danger)'};">${xss(i.stock)} in stock</span>
    </div>
    <div style="display:flex;gap:8px;margin-top:16px;">
      <button class="btn b-dark b-sm" onclick="editItem('${i.id}');closeModal('m-prod-view');"><i class="fa-solid fa-pen"></i> Edit</button>
      <button class="btn b-dang b-sm" onclick="del('menu/${i.id}');closeModal('m-prod-view');"><i class="fa-solid fa-trash"></i> Delete</button>
    </div>
  `;
  openModal('m-prod-view');
};

window.switchThumb = (url, el) => {
  document.getElementById('p-main').src = url;
  document.querySelectorAll('.thumb-img').forEach(t => t.classList.remove('active-thumb'));
  el.classList.add('active-thumb');
};

// ══════════════════════════════════════
//  REVIEWS CRUD
// ══════════════════════════════════════
window.openReviewModal = () => {
  document.getElementById('rev-modal-title').innerText = 'Add Manual Review';
  document.getElementById('ar-id').value = '';
  const sel = document.getElementById('ar-product');
  sel.innerHTML = DB.items.map(i => `<option value="${i.id}">${xss(i.name)}</option>`).join('');
  sel.disabled  = false;
  document.getElementById('ar-name').value    = '';
  document.getElementById('ar-rating').value  = '5';
  document.getElementById('ar-comment').value = '';
  openModal('m-add-review');
};

window.editReview = (prodId, revId) => {
  const r = DB.reviews[prodId]?.[revId]; if (!r) return;
  document.getElementById('rev-modal-title').innerText = 'Edit Review';
  document.getElementById('ar-id').value = revId;
  const sel = document.getElementById('ar-product');
  sel.innerHTML = `<option value="${prodId}" selected>${xss(DB.items.find(x=>x.id===prodId)?.name||'Product')}</option>`;
  sel.disabled  = true;
  document.getElementById('ar-name').value    = r.userName;
  document.getElementById('ar-rating').value  = r.rating;
  document.getElementById('ar-comment').value = r.comment;
  openModal('m-add-review');
};

window.saveAdminReview = () => {
  const pid     = document.getElementById('ar-product').value;
  const name    = document.getElementById('ar-name').value.trim();
  const rating  = parseInt(document.getElementById('ar-rating').value) || 5;
  const comment = document.getElementById('ar-comment').value.trim();
  const eid     = document.getElementById('ar-id').value;
  if (!name || !comment) { showToast("Name and comment required!", "error"); return; }
  const uid = eid || 'admin_' + Date.now();
  update(ref(db, `reviews/${pid}/${uid}`), {
    userId:uid, userName:name, rating, comment,
    timestamp: Date.now(), isAdminAdded:true
  }).then(() => { showToast("Review saved!", "success"); closeModal('m-add-review'); });
};

// ══════════════════════════════════════
//  SETTINGS
// ══════════════════════════════════════
window.toggleStore = (val) => {
  update(ref(db,'settings'), { store_open:val })
    .then(() => { showToast(`Store is now ${val?'ONLINE':'OFFLINE'}`, val?'success':'error'); })
    .catch(e  => {
      showToast("Failed to update store status", "error");
      const sw = document.getElementById('master-switch');
      if (sw) sw.checked = !val; // revert
    });
};

window.toggleStoreClick = (e) => { /* handled by checkbox onchange */ };

window.saveSettings = () => {
  const payload = {
    delivery_fee:      parseFloat(document.getElementById('set-del-fee').value) || 20,
    min_free_delivery: parseFloat(document.getElementById('set-free-min').value) || 500,
    min_order:         parseFloat(document.getElementById('set-min-order').value) || 100,
    max_radius:        parseFloat(document.getElementById('set-max-radius').value) || 10,
    cod_enabled:       document.getElementById('set-cod').checked,
    online_discount:   parseFloat(document.getElementById('set-online-disc').value) || 0
  };
  update(ref(db,'settings'), payload)
    .then(() => { showToast("Master controls updated!", "success"); secLog('ok','Settings updated'); });
};

// ══════════════════════════════════════
//  COUPONS
// ══════════════════════════════════════
window.openCoupModal = () => {
  const catSel = document.getElementById('cp-cat');
  catSel.innerHTML = '<option value="">All Menu (Global)</option>' +
    DB.cats.map(c => `<option value="${xss(c.name)}">${xss(c.name)}</option>`).join('');
  openModal('m-coup');
};

window.saveCoup = () => {
  const code = document.getElementById('cp-code').value.trim().toUpperCase();
  if (!code) { showToast("Coupon code required!", "error"); return; }
  const val = parseFloat(document.getElementById('cp-val').value);
  if (!val || val <= 0) { showToast("Discount value required!", "error"); return; }
  set(ref(db,'coupons/'+code), {
    value:    val,
    type:     document.getElementById('cp-type').value,
    minOrder: parseFloat(document.getElementById('cp-min').value) || 0,
    category: document.getElementById('cp-cat').value,
    maxUses:  parseInt(document.getElementById('cp-max-uses').value) || 9999,
    expiry:   document.getElementById('cp-expiry').value || null,
    usedCount:0, active:true, createdAt:Date.now()
  }).then(() => { showToast("Coupon launched! 🚀", "success"); closeModal('m-coup'); });
};

// ══════════════════════════════════════
//  BANNERS
// ══════════════════════════════════════
window.saveBan = () => {
  const img = document.getElementById('b-img').value.trim();
  if (!img) { showToast("Image URL required!", "error"); return; }
  push(ref(db,'sliders'), { image:img, createdAt:Date.now() })
    .then(() => { showToast("Banner uploaded!", "success"); closeModal('m-ban'); document.getElementById('b-img').value = ''; });
};

// ══════════════════════════════════════
//  DRIVERS
// ══════════════════════════════════════
window.updDriver = (id, data) => {
  update(ref(db,'deliveryPartners/'+id), data)
    .then(() => showToast("Driver status updated!", "success"));
};

// ══════════════════════════════════════
//  GENERIC DELETE
// ══════════════════════════════════════
window.del = (path) => {
  if (!confirm("Permanently delete this? This cannot be undone.")) return;
  remove(ref(db, path)).then(() => showToast("Deleted successfully", "info"));
};

// ══════════════════════════════════════
//  NAVIGATION
// ══════════════════════════════════════
window.nav = (page, el) => {
  document.querySelectorAll('[id^="view-"]').forEach(x => x.classList.add('hide'));
  const v = document.getElementById('view-'+page);
  if (v) { v.classList.remove('hide'); v.classList.remove('view-section'); void v.offsetWidth; v.classList.add('view-section'); }
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  if (el) el.classList.add('active');
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('overlay-sidebar').classList.remove('show');
  document.getElementById('page-title').innerText = page.toUpperCase().replace('-',' ');
};

window.toggleSidebar = () => {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('overlay-sidebar').classList.toggle('show');
};

// ══════════════════════════════════════
//  MODAL HELPERS
// ══════════════════════════════════════
window.openModal  = (id) => { const el = document.getElementById(id); if (el) el.style.display = 'flex'; };
window.closeModal = (id) => { const el = document.getElementById(id); if (el) el.style.display = 'none'; };

// Close modal on backdrop click
document.querySelectorAll('.modal').forEach(m => {
  m.addEventListener('click', (e) => { if (e.target === m) closeModal(m.id); });
});

// ESC key closes modals
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal').forEach(m => { if (m.style.display !== 'none') closeModal(m.id); });
  }
});

// ══════════════════════════════════════
//  BROADCAST HELPER (backward compat)
// ══════════════════════════════════════
window.sendNotification = window.sendPushNotification;

</script>
</body>
</html>
