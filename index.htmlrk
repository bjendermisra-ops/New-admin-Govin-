<!DOCTYPE html>
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║   demo— ENTERPRISE ADMIN PANEL                          ║
  ║   Version: 3.0.0 PRODUCTION                                    ║
  ║   Firebase: Realtime DB + Auth                                 ║
  ║   Security: Rate Limit + Session Lock + XSS Guard + CSP        ║
  ║   Features: Orders, Menu, VIP CRM, Drivers, Analytics,        ║
  ║             Push Notifications, WhatsApp Bill, Print,          ║
  ║             Broadcast, Coupons, Banners, Reviews               ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="X-Frame-Options" content="DENY">
  <meta name="referrer" content="no-referrer">
  <title>demo| Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style>
    :root {
      --brand: #FF6D00;
      --brand-dark: #E65100;
      --brand-light: #FFF3E0;
      --dark: #0F1117;
      --dark2: #1A1D24;
      --dark3: #22262F;
      --sidebar-bg: #0F1117;
      --light: #F5F6FA;
      --white: #ffffff;
      --text: #1A1D24;
      --text-muted: #8A8F9A;
      --sidebar-w: 265px;
      --success: #00C853;
      --danger: #FF3D57;
      --warn: #FFAB00;
      --info: #2979FF;
      --whatsapp: #25D366;
      --gold: #FFD700;
      --gold-dark: #F59E0B;
      --border: rgba(255,255,255,0.06);
      --radius: 14px;
      --shadow: 0 4px 24px rgba(0,0,0,0.08);
      --shadow-md: 0 8px 32px rgba(0,0,0,0.12);
      --shadow-lg: 0 20px 60px rgba(0,0,0,0.18);
      --transition: 0.22s cubic-bezier(.4,0,.2,1);
    }

    * { margin:0; padding:0; box-sizing:border-box; font-family:'DM Sans',sans-serif; outline:none; -webkit-tap-highlight-color:transparent; }

    body { background:var(--light); color:var(--text); display:flex; height:100vh; overflow:hidden; }

    /* ──── SCROLLBAR ──── */
    ::-webkit-scrollbar { width:5px; height:5px; }
    ::-webkit-scrollbar-track { background:transparent; }
    ::-webkit-scrollbar-thumb { background:rgba(0,0,0,0.15); border-radius:10px; }

    /* ──── SECURITY SCREEN ──── */
    #view-auth {
      position:fixed; inset:0; background:var(--dark);
      z-index:9999; display:flex; align-items:center; justify-content:center;
      background-image: radial-gradient(ellipse at 20% 50%, rgba(255,109,0,0.15) 0%, transparent 50%),
                        radial-gradient(ellipse at 80% 20%, rgba(41,121,255,0.1) 0%, transparent 50%);
    }
    .auth-box {
      background:var(--dark2); border:1px solid rgba(255,109,0,0.2);
      padding:44px 40px; width:420px; max-width:92%; border-radius:20px;
      box-shadow:0 40px 80px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
      animation:authIn 0.5s cubic-bezier(.34,1.56,.64,1);
    }
    @keyframes authIn { from{transform:scale(0.9) translateY(20px);opacity:0;} to{transform:scale(1) translateY(0);opacity:1;} }
    .auth-logo { font-family:'Syne',sans-serif; font-size:2rem; font-weight:800; color:white; margin-bottom:6px; }
    .auth-logo span { color:var(--brand); }
    .auth-sub { color:var(--text-muted); font-size:0.9rem; margin-bottom:30px; }
    .auth-inp {
      width:100%; padding:14px 16px; background:rgba(255,255,255,0.05);
      border:1px solid rgba(255,255,255,0.1); border-radius:10px;
      color:white; font-size:0.95rem; margin-bottom:14px; transition:var(--transition);
    }
    .auth-inp:focus { border-color:var(--brand); background:rgba(255,109,0,0.08); }
    .auth-inp::placeholder { color:rgba(255,255,255,0.3); }
    .auth-err { color:var(--danger); font-size:0.8rem; margin-top:10px; text-align:center; min-height:20px; }
    .auth-lockout { background:rgba(255,61,87,0.1); border:1px solid rgba(255,61,87,0.3); border-radius:8px; padding:10px; color:var(--danger); font-size:0.82rem; text-align:center; margin-top:10px; display:none; }
    .rate-info { color:var(--text-muted); font-size:0.75rem; text-align:center; margin-top:12px; }

    /* ──── TOAST ──── */
    #toast-container { position:fixed; bottom:24px; right:24px; z-index:10000; display:flex; flex-direction:column; gap:10px; pointer-events:none; }
    .toast {
      background:var(--dark2); color:white; padding:13px 20px;
      border-radius:10px; font-size:0.875rem; font-weight:600;
      box-shadow:var(--shadow-lg); display:flex; align-items:center; gap:10px;
      animation:toastIn 0.35s cubic-bezier(.34,1.56,.64,1), toastOut 0.3s forwards 2.7s;
      max-width:340px; pointer-events:all;
    }
    .toast.success { border-left:4px solid var(--success); }
    .toast.error   { border-left:4px solid var(--danger); }
    .toast.info    { border-left:4px solid var(--brand); }
    .toast.warn    { border-left:4px solid var(--warn); }
    @keyframes toastIn  { from{transform:translateX(110%);opacity:0;} to{transform:translateX(0);opacity:1;} }
    @keyframes toastOut { from{opacity:1;transform:translateX(0);} to{opacity:0;transform:translateX(110%);} }

    /* ──── SIDEBAR ──── */
    aside {
      width:var(--sidebar-w); background:var(--sidebar-bg); color:#7A8190;
      display:flex; flex-direction:column; transition:var(--transition);
      position:relative; z-index:100; flex-shrink:0;
      border-right:1px solid var(--border);
    }
    @media(max-width:768px) {
      aside { position:fixed; left:calc(-1 * var(--sidebar-w)); top:0; bottom:0; box-shadow:var(--shadow-lg); }
      aside.open { left:0; }
    }
    .logo {
      height:72px; display:flex; align-items:center; padding:0 22px;
      font-family:'Syne',sans-serif; font-weight:800; font-size:1.5rem;
      color:white; border-bottom:1px solid var(--border); gap:10px; flex-shrink:0;
    }
    .logo-icon { width:36px; height:36px; background:var(--brand); border-radius:10px; display:grid; place-items:center; color:white; font-size:1rem; flex-shrink:0; }
    .nav-section { padding:14px 14px 6px; font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#3D4250; }
    .nav-list { padding:8px 12px; overflow-y:auto; flex:1; }
    .nav-btn {
      padding:11px 14px; margin-bottom:3px; cursor:pointer; border-radius:10px;
      font-weight:600; font-size:0.88rem; display:flex; align-items:center; gap:13px;
      transition:var(--transition); color:#7A8190; position:relative; user-select:none;
    }
    .nav-btn:hover { background:rgba(255,255,255,0.05); color:white; }
    .nav-btn.active { background:var(--brand); color:white; box-shadow:0 4px 15px rgba(255,109,0,0.4); }
    .nav-btn.gold-btn:hover,.nav-btn.gold-btn.active { background:linear-gradient(135deg,#F59E0B,#FBBF24); color:#111; box-shadow:0 4px 15px rgba(245,158,11,0.4); }
    .nav-btn i { width:18px; text-align:center; font-size:1rem; }
    .nav-badge { margin-left:auto; background:var(--danger); color:white; padding:2px 7px; border-radius:20px; font-size:0.68rem; font-weight:800; display:none; animation:pulse 1.5s infinite; }
    @keyframes pulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.15);} }
    .sidebar-footer { padding:16px 12px; border-top:1px solid var(--border); }
    .broadcast-btn { width:100%; padding:12px; background:rgba(41,121,255,0.15); border:1px solid rgba(41,121,255,0.3); border-radius:10px; color:#5599FF; font-weight:700; font-size:0.85rem; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:10px; transition:var(--transition); }
    .broadcast-btn:hover { background:rgba(41,121,255,0.25); }
    .logout-btn { width:100%; padding:11px; background:rgba(255,61,87,0.1); border:1px solid rgba(255,61,87,0.2); border-radius:10px; color:#FF3D57; font-weight:700; font-size:0.85rem; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition:var(--transition); }
    .logout-btn:hover { background:rgba(255,61,87,0.2); }

    /* ──── MAIN ──── */
    #overlay-sidebar { position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:90; display:none; backdrop-filter:blur(4px); }
    #overlay-sidebar.show { display:block; }
    main { flex:1; display:flex; flex-direction:column; overflow:hidden; position:relative; min-width:0; }
    header {
      height:68px; background:white; border-bottom:1px solid #EFEFEF;
      display:flex; justify-content:space-between; align-items:center;
      padding:0 24px; z-index:80; flex-shrink:0; gap:16px;
      box-shadow:0 1px 0 #F0F0F0;
    }
    .h-left { display:flex; align-items:center; gap:14px; }
    .menu-toggle { display:none; font-size:1.3rem; cursor:pointer; color:var(--dark); padding:6px; border-radius:8px; transition:var(--transition); }
    .menu-toggle:hover { background:#f5f5f5; }
    .h-title { font-family:'Syne',sans-serif; font-weight:800; font-size:1.2rem; color:var(--dark); }
    @media(max-width:768px) { .menu-toggle{display:block;} .h-title{font-size:1rem;} header{padding:0 16px;} }
    .store-pill {
      display:flex; align-items:center; gap:10px; padding:7px 14px;
      border-radius:30px; border:2px solid transparent; transition:var(--transition);
      font-size:0.78rem; cursor:pointer; font-weight:700; gap:8px;
    }
    .store-pill.online  { background:#E8F5E9; border-color:var(--success); color:#1B5E20; }
    .store-pill.offline { background:#FFEBEE; border-color:var(--danger);  color:#B71C1C; }
    .store-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .store-pill.online .store-dot  { background:var(--success); box-shadow:0 0 6px var(--success); animation:pulse 1.5s infinite; }
    .store-pill.offline .store-dot { background:var(--danger); }
    .header-actions { display:flex; align-items:center; gap:10px; }
    .header-time { font-size:0.78rem; color:var(--text-muted); font-weight:600; background:#f5f5f5; padding:6px 12px; border-radius:8px; white-space:nowrap; }

    /* ──── CONTENT ──── */
    .content { padding:22px; overflow-y:auto; flex:1; -webkit-overflow-scrolling:touch; }

    /* ──── GRID ──── */
    .grid-4  { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-bottom:22px; }
    .grid-3  { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
    .grid-2  { display:grid; grid-template-columns:1fr 1.6fr; gap:18px; }
    .grid-2r { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
    @media(max-width:1200px) { .grid-4{grid-template-columns:repeat(2,1fr);} }
    @media(max-width:1024px) { .grid-2{grid-template-columns:1fr;} .grid-3{grid-template-columns:repeat(2,1fr);} }
    @media(max-width:640px)  { .grid-4{grid-template-columns:1fr;} .grid-2r{grid-template-columns:1fr;} .grid-3{grid-template-columns:1fr;} }

    /* ──── CARD ──── */
    .card {
      background:white; padding:22px; border-radius:var(--radius);
      box-shadow:var(--shadow); border:1px solid #F0F0F0;
    }
    .card-title { font-family:'Syne',sans-serif; font-weight:700; font-size:1rem; color:var(--dark); }

    /* ──── KPI CARDS ──── */
    .kpi-card { background:white; padding:20px; border-radius:var(--radius); box-shadow:var(--shadow); border:1px solid #F0F0F0; position:relative; overflow:hidden; }
    .kpi-card::before { content:''; position:absolute; top:0; left:0; width:4px; height:100%; border-radius:4px 0 0 4px; }
    .kpi-card.c-brand::before { background:var(--brand); }
    .kpi-card.c-success::before { background:var(--success); }
    .kpi-card.c-warn::before { background:var(--warn); }
    .kpi-card.c-dark::before { background:var(--dark); }
    .kpi-card.c-info::before { background:var(--info); }
    .kpi-icon { width:44px; height:44px; border-radius:12px; display:grid; place-items:center; margin-bottom:14px; font-size:1.1rem; }
    .kpi-card.c-brand .kpi-icon { background:var(--brand-light); color:var(--brand); }
    .kpi-card.c-success .kpi-icon { background:#E8F5E9; color:var(--success); }
    .kpi-card.c-warn .kpi-icon { background:#FFF8E1; color:var(--warn); }
    .kpi-card.c-dark .kpi-icon { background:#F5F5F5; color:var(--dark); }
    .kpi-card.c-info .kpi-icon { background:#E3F2FD; color:var(--info); }
    .kpi-val { font-family:'Syne',sans-serif; font-size:1.85rem; font-weight:800; color:var(--dark); line-height:1; margin-bottom:4px; }
    .kpi-lbl { font-size:0.75rem; text-transform:uppercase; color:var(--text-muted); font-weight:700; letter-spacing:0.08em; }
    .kpi-trend { font-size:0.78rem; font-weight:600; margin-top:8px; }
    .kpi-trend.up { color:var(--success); }
    .kpi-trend.down { color:var(--danger); }

    /* ──── TABLE ──── */
    .tbl-wrap { overflow-x:auto; border-radius:10px; border:1px solid #F0F0F0; margin-top:14px; }
    table { width:100%; border-collapse:collapse; min-width:550px; background:white; }
    thead tr { background:#FAFAFA; }
    th { padding:11px 14px; text-align:left; font-size:0.68rem; text-transform:uppercase; color:var(--text-muted); font-weight:800; letter-spacing:0.1em; white-space:nowrap; }
    td { padding:13px 14px; border-bottom:1px solid #F8F8F8; font-size:0.85rem; font-weight:600; color:#333; vertical-align:middle; }
    tr:last-child td { border-bottom:none; }
    tr:hover td { background:#FAFAFA; }

    /* ──── BADGE ──── */
    .badge { padding:4px 9px; border-radius:6px; font-size:0.68rem; font-weight:800; text-transform:uppercase; display:inline-block; white-space:nowrap; letter-spacing:0.05em; }
    .bg-new  { background:#FFF3E0; color:#E65100; }
    .bg-cook { background:#E3F2FD; color:#1565C0; }
    .bg-out  { background:#F3E5F5; color:#6A1B9A; }
    .bg-done { background:#E8F5E9; color:#1B5E20; }
    .bg-can  { background:#FFEBEE; color:#B71C1C; }
    .bg-gold { background:#FEF3C7; color:#92400E; }
    .bg-info { background:#E3F2FD; color:#1565C0; }

    /* ──── BUTTONS ──── */
    .btn {
      padding:11px 20px; border:none; border-radius:10px; font-weight:700;
      cursor:pointer; transition:var(--transition); display:inline-flex; align-items:center;
      justify-content:center; gap:8px; font-size:0.875rem; letter-spacing:0.01em;
      font-family:'DM Sans',sans-serif; white-space:nowrap;
    }
    .btn:hover  { filter:brightness(1.08); transform:translateY(-1px); }
    .btn:active { transform:scale(0.96) translateY(0); }
    .btn:disabled { opacity:0.5; cursor:not-allowed; transform:none; filter:none; }
    .b-prim  { background:var(--brand); color:white; box-shadow:0 4px 12px rgba(255,109,0,0.35); }
    .b-dark  { background:var(--dark); color:white; }
    .b-succ  { background:var(--success); color:white; box-shadow:0 4px 12px rgba(0,200,83,0.3); }
    .b-dang  { background:var(--danger); color:white; }
    .b-info  { background:var(--info); color:white; }
    .b-gold  { background:linear-gradient(135deg,#F59E0B,#FBBF24); color:#111; box-shadow:0 4px 12px rgba(245,158,11,0.4); }
    .b-wa    { background:var(--whatsapp); color:white; }
    .b-ghost { background:transparent; border:1.5px solid #E0E0E0; color:var(--text-muted); }
    .b-ghost:hover { border-color:var(--brand); color:var(--brand); background:var(--brand-light); filter:none; transform:none; }
    .b-sm { padding:7px 13px; font-size:0.78rem; border-radius:7px; }
    .b-xs { padding:5px 10px; font-size:0.72rem; border-radius:6px; }

    /* ──── FORM INPUTS ──── */
    .inp {
      width:100%; padding:12px 14px; border:1.5px solid #E8E8E8;
      border-radius:10px; margin-bottom:14px; background:#FAFAFA;
      transition:var(--transition); font-size:0.9rem; color:var(--text);
      font-family:'DM Sans',sans-serif;
    }
    .inp:focus { border-color:var(--brand); background:white; box-shadow:0 0 0 3px rgba(255,109,0,0.08); }
    .inp-grp { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    @media(max-width:500px) { .inp-grp{grid-template-columns:1fr;} }
    label.lbl { display:block; font-size:0.78rem; font-weight:700; color:var(--text-muted); margin-bottom:6px; text-transform:uppercase; letter-spacing:0.06em; }

    /* ──── MODAL ──── */
    .modal {
      position:fixed; inset:0; background:rgba(15,17,23,0.7);
      z-index:2000; display:none; align-items:flex-end; justify-content:center;
      backdrop-filter:blur(6px);
    }
    @media(min-width:600px) { .modal { align-items:center; } }
    .modal-box {
      background:white; width:560px; max-width:100%; max-height:92vh;
      padding:28px; border-radius:20px 20px 0 0; overflow-y:auto;
      animation:slideUp 0.32s cubic-bezier(.34,1.56,.64,1);
      box-shadow:var(--shadow-lg); position:relative;
    }
    @media(min-width:600px) { .modal-box { border-radius:20px; animation:popIn 0.3s cubic-bezier(.34,1.56,.64,1); } }
    @keyframes slideUp { from{transform:translateY(100%);opacity:0;} to{transform:translateY(0);opacity:1;} }
    @keyframes popIn   { from{transform:scale(0.93);opacity:0;} to{transform:scale(1);opacity:1;} }
    .modal-hdr { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
    .modal-title { font-family:'Syne',sans-serif; font-weight:700; font-size:1.1rem; }
    .close-x { width:36px; height:36px; display:grid; place-items:center; background:#F5F5F5; border-radius:50%; cursor:pointer; font-size:1.1rem; color:#888; transition:var(--transition); flex-shrink:0; border:none; }
    .close-x:hover { background:#FFE0E0; color:var(--danger); }

    /* ──── SWITCH ──── */
    .switch { position:relative; display:inline-block; width:44px; height:24px; }
    .switch input { opacity:0; width:0; height:0; }
    .slider { position:absolute; cursor:pointer; inset:0; background:#DDD; transition:.35s; border-radius:34px; }
    .slider:before { position:absolute; content:""; height:18px; width:18px; left:3px; bottom:3px; background:white; transition:.35s; border-radius:50%; box-shadow:0 1px 4px rgba(0,0,0,0.2); }
    input:checked + .slider { background:var(--success); }
    input:checked + .slider:before { transform:translateX(20px); }

    /* ──── PRINT ──── */
    #invoice-layout { display:none; width:80mm; padding:2mm; background:white; color:black; font-family:'Courier New',monospace; line-height:1.25; }
    @media print { body * { visibility:hidden; } #invoice-layout, #invoice-layout * { visibility:visible; } #invoice-layout { position:absolute; left:0; top:0; width:100%; display:block; } }

    /* ──── UTILS ──── */
    .hide { display:none !important; }
    .flex-between { display:flex; justify-content:space-between; align-items:center; }
    .text-sm  { font-size:0.82rem; color:var(--text-muted); }
    .text-muted { color:var(--text-muted); }
    .ellipsis { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:inline-block; max-width:200px; }
    .stars-row { display:flex; gap:2px; }
    .star-gold { color:#F59E0B; font-size:0.8rem; }
    .star-gray { color:#E0E0E0; font-size:0.8rem; }
    .device-badge { font-size:0.65rem; background:#F3E5F5; color:#6A1B9A; padding:2px 6px; border-radius:4px; margin-left:5px; font-weight:700; }
    .setting-row { display:flex; justify-content:space-between; align-items:center; padding:16px 0; border-bottom:1px solid #F5F5F5; }
    .hist-item { background:#FAFAFA; padding:14px; border-radius:10px; border:1px solid #F0F0F0; margin-bottom:10px; display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
    .driver-tabs { display:flex; gap:8px; margin-bottom:14px; border-bottom:1px solid #F0F0F0; }
    .d-tab { padding:10px 14px; font-size:0.88rem; font-weight:700; cursor:pointer; color:var(--text-muted); border-bottom:3px solid transparent; transition:var(--transition); }
    .d-tab.active { color:var(--brand); border-color:var(--brand); }
    .thumb-row { display:flex; gap:8px; overflow-x:auto; padding-bottom:5px; }
    .thumb-img { width:52px; height:52px; object-fit:cover; border-radius:8px; cursor:pointer; border:2px solid transparent; opacity:0.65; transition:var(--transition); flex-shrink:0; }
    .thumb-img:hover { opacity:0.9; }
    .thumb-img.active-thumb { border-color:var(--brand); opacity:1; }
    .prev-main-img { width:100%; height:210px; object-fit:contain; border-radius:12px; border:1px solid #F0F0F0; margin-bottom:12px; background:#FAFAFA; }
    .unit-tag { display:inline-block; background:var(--brand-light); color:var(--brand-dark); font-size:0.72rem; padding:3px 8px; border-radius:5px; font-weight:700; }

    /* ──── ORDER STATUS INDICATOR ──── */
    .live-dot { width:8px; height:8px; background:var(--success); border-radius:50%; display:inline-block; animation:pulse 1.5s infinite; margin-right:6px; }

    /* ──── CHART CONTAINER ──── */
    .chart-wrap { position:relative; height:300px; }

    /* ──── SESSION BAR ──── */
    #session-bar { position:fixed; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg, var(--brand), var(--gold-dark)); z-index:99999; transform-origin:left; transform:scaleX(1); transition:transform 1s linear; }

    /* ──── SECURITY EVENTS LOG ──── */
    #sec-log-list { max-height:250px; overflow-y:auto; }
    .sec-event { display:flex; gap:10px; align-items:flex-start; padding:10px; border-radius:8px; margin-bottom:8px; font-size:0.82rem; }
    .sec-event.warn  { background:#FFF8E1; border-left:3px solid var(--warn); }
    .sec-event.error { background:#FFEBEE; border-left:3px solid var(--danger); }
    .sec-event.ok    { background:#E8F5E9; border-left:3px solid var(--success); }

    /* ──── VIP GRADIENT CARD ──── */
    .vip-header-card { background:linear-gradient(135deg,#FFF8E1,#FFFBF0); border:1px solid #FFE082; border-radius:var(--radius); padding:22px; margin-bottom:20px; }

    /* ──── LOADING SPINNER ──── */
    .spinner { display:inline-block; width:16px; height:16px; border:2px solid rgba(255,255,255,0.4); border-top-color:white; border-radius:50%; animation:spin 0.7s linear infinite; }
    @keyframes spin { to{transform:rotate(360deg);} }

    /* ──── PAGE TRANSITION ──── */
    .view-section { animation:fadeSlide 0.25s ease; }
    @keyframes fadeSlide { from{opacity:0;transform:translateY(8px);} to{opacity:1;transform:translateY(0);} }

    /* ──── AUDIO ──── */
    #order-sound { display:none; }

    /* ──── EMPTY STATE ──── */
    .empty-state { text-align:center; padding:50px 20px; color:var(--text-muted); }
    .empty-state i { font-size:3rem; margin-bottom:12px; opacity:0.3; display:block; }
    .empty-state p { font-size:0.9rem; }

    /* ──── INPUT INLINE LABEL ──── */
    .inp-wrap { margin-bottom:14px; }
    .inp-wrap .inp { margin-bottom:0; }

    /* ──── COUPON ITEM ──── */
    .coup-item { display:flex; justify-content:space-between; align-items:center; background:#FAFAFA; padding:12px; border-radius:10px; margin-bottom:8px; border:1px solid #F0F0F0; }

    /* ──── BAN IMAGE ──── */
    .ban-card { position:relative; border-radius:8px; overflow:hidden; }
    .ban-card img { width:100%; height:88px; object-fit:cover; display:block; }
    .ban-del { position:absolute; top:6px; right:6px; background:white; border-radius:50%; width:26px; height:26px; display:grid; place-items:center; cursor:pointer; color:var(--danger); font-size:0.75rem; box-shadow:var(--shadow); transition:var(--transition); border:none; }
    .ban-del:hover { background:var(--danger); color:white; }

    /* ──── ANALYTICS TABS ──── */
    .analytics-tabs { display:flex; gap:6px; margin-bottom:16px; background:#F5F5F5; padding:5px; border-radius:10px; width:fit-content; }
    .a-tab { padding:7px 16px; border-radius:7px; font-size:0.8rem; font-weight:700; cursor:pointer; color:var(--text-muted); transition:var(--transition); }
    .a-tab.active { background:white; color:var(--brand); box-shadow:var(--shadow); }

  </style>
</head>
<body>

<!-- HIDDEN AUDIO FOR NEW ORDER ALERT -->
<audio id="order-sound" preload="auto">
  <source src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" type="audio/mpeg">
</audio>

<!-- SESSION PROGRESS BAR -->
<div id="session-bar"></div>

<!-- PRINT INVOICE -->
<div id="invoice-layout">
  <center>
    <h2 style="margin:0;font-size:16px;font-weight:800;">GOVINDA'S PRASADAM</h2>
    <p style="font-size:10px;margin:2px;">ISKCON Hadapsar, Pune</p>
    <p style="font-size:10px;border-bottom:1px dashed #000;padding-bottom:5px;">Pure Veg • Satvik • Divine 🙏</p>
  </center>
  <div style="font-size:11px;margin-top:10px;">
    Order: <b id="inv-id">#0000</b><br>
    Name: <span id="inv-name">--</span><br>
    Time: <span id="inv-date">--</span>
  </div>
  <table style="width:100%;font-size:11px;margin-top:10px;border-top:1px dashed #000;border-bottom:1px dashed #000;">
    <thead><tr style="text-align:left;"><th>Item</th><th style="text-align:right;">Price</th></tr></thead>
    <tbody id="inv-items"></tbody>
  </table>
  <div style="text-align:right;font-size:11px;margin-top:5px;">
    <div id="inv-sub"></div><div id="inv-del"></div><div id="inv-disc"></div>
    <b style="font-size:14px;margin-top:5px;display:block;">TOTAL: <span id="inv-total">0</span></b>
  </div>
  <center style="font-size:10px;margin-top:15px;font-weight:bold;">** THANK YOU **<br>Hare Krishna! 🙏</center>
</div>

<!-- TOAST CONTAINER -->
<div id="toast-container"></div>

<!-- ══════════════════════ AUTH SCREEN ══════════════════════ -->
<div id="view-auth">
  <div class="auth-box">
    <div class="auth-logo"><span><i class="icon"></i></span> demo</div>
    <div class="auth-sub">Secure Admin Control Center</div>
    <input type="email"    id="login-email" class="auth-inp" placeholder="Admin Email"    autocomplete="email">
    <input type="password" id="login-pass"  class="auth-inp" placeholder="Password"       autocomplete="current-password" onkeydown="if(event.key==='Enter') handleLogin()">
    <button id="login-btn" class="btn b-prim" style="width:100%;padding:15px;font-size:1rem;" onclick="handleLogin()">
      <i class="fa-solid fa-shield-halved"></i> SECURE LOGIN
    </button>
    <div id="auth-err" class="auth-err"></div>
    <div id="auth-lockout" class="auth-lockout"><i class="fa-solid fa-lock"></i> Too many failed attempts. Try again in <span id="lockout-timer">30</span>s</div>
    <div class="rate-info"><i class="fa-solid fa-lock"></i> Protected by rate limiting &amp; session encryption</div>
  </div>
</div>

<!-- ══════════════════════ SIDEBAR OVERLAY ══════════════════════ -->
<div id="overlay-sidebar" onclick="toggleSidebar()"></div>

<!-- ══════════════════════ SIDEBAR ══════════════════════ -->
<aside id="sidebar">
  <div class="logo">
    <div class="logo-icon"><i class="icon"></i></div>
    demo
  </div>
  <div class="nav-list">
    <div class="nav-section">Main</div>
    <div class="nav-btn active" onclick="nav('dashboard',this)"><i class="fa-solid fa-chart-pie"></i> Dashboard</div>
    <div class="nav-btn" onclick="nav('orders',this)">
      <i class="fa-solid fa-bell"></i> Live Orders
      <span id="nav-badge" class="nav-badge">0</span>
    </div>
    <div class="nav-section">Manage</div>
    <div class="nav-btn" onclick="nav('menu',this)"><i class="fa-solid fa-utensils"></i> Menu & Dishes</div>
    <div class="nav-btn gold-btn" onclick="nav('loyalty',this)"><i class="fa-solid fa-crown" style="color:#F59E0B;"></i> VIP CRM</div>
    <div class="nav-btn" onclick="nav('customers',this)"><i class="fa-solid fa-users"></i> Customers</div>
    <div class="nav-btn" onclick="nav('reviews',this)"><i class="fa-solid fa-star"></i> Reviews</div>
    <div class="nav-section">Operations</div>
    <div class="nav-btn" onclick="nav('marketing',this)"><i class="fa-solid fa-ticket"></i> Coupons/Banners</div>
    <div class="nav-btn" onclick="nav('drivers',this)"><i class="fa-solid fa-motorcycle"></i> Drivers</div>
    <div class="nav-section">System</div>
    <div class="nav-btn" onclick="nav('settings',this)"><i class="fa-solid fa-sliders"></i> Settings</div>
    <div class="nav-btn" onclick="nav('security',this)"><i class="fa-solid fa-shield-halved"></i> Security Log</div>
  </div>
  <div class="sidebar-footer">
    <button class="broadcast-btn" onclick="openModal('m-broadcast')">
      <i class="fa-solid fa-bullhorn"></i> Broadcast to All
    </button>
    <button class="logout-btn" onclick="logout()">
      <i class="fa-solid fa-right-from-bracket"></i> Secure Logout
    </button>
  </div>
</aside>

<!-- ══════════════════════ MAIN ══════════════════════ -->
<main>
  <header>
    <div class="h-left">
      <div class="menu-toggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></div>
      <div class="h-title" id="page-title">DASHBOARD</div>
    </div>
    <div class="header-actions">
      <div class="header-time" id="header-clock">--:--:--</div>
      <div id="store-toggle" class="store-pill online" onclick="toggleStoreClick()">
        <div class="store-dot"></div>
        <span id="store-status-text">ONLINE</span>
        <label class="switch" onclick.stop><input type="checkbox" id="master-switch" checked onchange="toggleStore(this.checked)"><span class="slider"></span></label>
      </div>
    </div>
  </header>

  <div class="content">

    <!-- ──── DASHBOARD ──── -->
    <div id="view-dashboard" class="view-section">
      <div class="grid-4">
        <div class="kpi-card c-brand">
          <div class="kpi-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
          <div class="kpi-val" id="d-sales">₹0</div>
          <div class="kpi-lbl">Total Revenue</div>
          <div class="kpi-trend up" id="d-sales-trend"><i class="fa-solid fa-arrow-up"></i> Today</div>
        </div>
        <div class="kpi-card c-success">
          <div class="kpi-icon"><i class="fa-solid fa-check-circle"></i></div>
          <div class="kpi-val" id="d-orders">0</div>
          <div class="kpi-lbl">Completed Orders</div>
          <div class="kpi-trend up" id="d-orders-trend"><i class="fa-solid fa-arrow-up"></i> Delivered</div>
        </div>
        <div class="kpi-card c-warn">
          <div class="kpi-icon"><i class="fa-solid fa-fire-burner"></i></div>
          <div class="kpi-val" id="d-pending">0</div>
          <div class="kpi-lbl">Kitchen Queue</div>
          <div class="kpi-trend" id="d-pend-trend" style="color:var(--warn);">Active Now</div>
        </div>
        <div class="kpi-card c-info">
          <div class="kpi-icon"><i class="fa-solid fa-users"></i></div>
          <div class="kpi-val" id="d-custs">0</div>
          <div class="kpi-lbl">Customers</div>
          <div class="kpi-trend up"><i class="fa-solid fa-arrow-up"></i> Registered</div>
        </div>
      </div>

      <div class="grid-2" style="margin-bottom:18px;">
        <div class="card">
          <div class="flex-between" style="margin-bottom:16px;">
            <span class="card-title">Revenue Analytics</span>
            <div class="analytics-tabs">
              <div class="a-tab active" onclick="switchChart('week',this)">7 Days</div>
              <div class="a-tab" onclick="switchChart('month',this)">30 Days</div>
            </div>
          </div>
          <div class="chart-wrap"><canvas id="sales-chart"></canvas></div>
        </div>
        <div class="card">
          <div class="flex-between" style="margin-bottom:16px;">
            <span class="card-title">Order Status Split</span>
          </div>
          <div class="chart-wrap" style="height:260px;"><canvas id="status-chart"></canvas></div>
        </div>
      </div>

      <div class="card">
        <div class="flex-between" style="margin-bottom:14px;">
          <span class="card-title">Recent Orders</span>
          <button class="btn b-ghost b-sm" onclick="nav('orders',document.querySelector('.nav-btn:nth-child(3)'))">View All →</button>
        </div>
        <div class="tbl-wrap"><table id="dash-recent-table"><thead><tr><th>#ID</th><th>Customer</th><th>Amount</th><th>Status</th><th>Time</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- ──── ORDERS ──── -->
    <div id="view-orders" class="view-section hide">
      <div class="flex-between" style="margin-bottom:16px; flex-wrap:wrap; gap:10px;">
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <button class="btn b-sm" id="f-all"      onclick="filterOrders('all',this)"      style="background:var(--dark);color:white;">All</button>
          <button class="btn b-sm b-ghost" id="f-placed"   onclick="filterOrders('placed',this)">New 🔔</button>
          <button class="btn b-sm b-ghost" id="f-cooking"  onclick="filterOrders('cooking',this)">Cooking 👨‍🍳</button>
          <button class="btn b-sm b-ghost" id="f-out"      onclick="filterOrders('out_for_delivery',this)">Out 🛵</button>
          <button class="btn b-sm b-ghost" id="f-done"     onclick="filterOrders('completed',this)">Done ✅</button>
          <button class="btn b-sm b-ghost" id="f-can"      onclick="filterOrders('cancelled',this)">Cancelled ❌</button>
        </div>
        <div style="display:flex;align-items:center;gap:8px;font-size:0.8rem;color:var(--text-muted);">
          <span class="live-dot"></span> Real-time sync active
        </div>
      </div>
      <div class="card" style="padding:0; overflow:hidden;">
        <div class="tbl-wrap" style="margin-top:0; border-radius:0; border:none;">
          <table id="order-list">
            <thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th>Time</th><th>Actions</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ──── MENU ──── -->
    <div id="view-menu" class="view-section hide">
      <div class="grid-2">
        <div class="card" style="height:fit-content;">
          <div class="flex-between" style="margin-bottom:16px;">
            <span class="card-title">Categories</span>
            <button class="btn b-dark b-sm" onclick="openCatModal()"><i class="fa-solid fa-plus"></i> Add</button>
          </div>
          <div id="cat-list"></div>
        </div>
        <div class="card">
          <div class="flex-between" style="margin-bottom:16px;">
            <span class="card-title">Menu Items <span id="item-count" style="font-size:0.75rem;background:#f0f0f0;padding:3px 8px;border-radius:6px;margin-left:6px;">0</span></span>
            <div style="display:flex;gap:8px;">
              <input type="text" id="item-search" placeholder="Search dish..." class="inp" style="width:160px;margin:0;padding:8px 12px;font-size:0.82rem;" oninput="filterMenu(this.value)">
              <button class="btn b-prim b-sm" onclick="openAddItemModal()"><i class="fa-solid fa-plus"></i> Add Dish</button>
            </div>
          </div>
          <div class="tbl-wrap"><table id="item-list"><thead><tr><th>Dish</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody></tbody></table></div>
        </div>
      </div>
    </div>

    <!-- ──── VIP CRM ──── -->
    <div id="view-loyalty" class="view-section hide">
      <div class="vip-header-card">
        <div class="flex-between">
          <div>
            <h3 style="color:#92400E;font-family:'Syne',sans-serif;font-size:1.1rem;"><i class="fa-solid fa-crown" style="color:var(--gold-dark);"></i> VIP Customer CRM</h3>
            <p style="font-size:0.82rem;color:#78350F;margin-top:4px;">Track your most loyal devotees • Bronze → Silver → Gold VIP</p>
          </div>
          <div style="text-align:right;">
            <div class="kpi-val" id="vip-gold-count" style="font-size:1.5rem;color:var(--gold-dark);">0</div>
            <div class="text-sm">Gold VIPs</div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="flex-between" style="margin-bottom:14px;">
          <span class="card-title">All VIP Customers</span>
          <input type="text" id="vip-search" placeholder="Search customer..." class="inp" style="width:180px;margin:0;padding:8px 12px;font-size:0.82rem;" oninput="filterVip(this.value)">
        </div>
        <div class="tbl-wrap">
          <table id="loyalty-list-table">
            <thead><tr><th>Customer</th><th>Orders</th><th>Spent</th><th>Level</th><th>Last Order</th><th>Actions</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ──── REVIEWS ──── -->
    <div id="view-reviews" class="view-section hide">
      <div class="card">
        <div class="flex-between" style="margin-bottom:16px;">
          <span class="card-title">Customer Reviews</span>
          <button class="btn b-succ b-sm" onclick="openReviewModal()"><i class="fa-solid fa-plus"></i> Add Review</button>
        </div>
        <div class="tbl-wrap">
          <table id="review-list-table">
            <thead><tr><th>Product</th><th>User</th><th>Rating</th><th>Comment</th><th>Type</th><th>Date</th><th>Actions</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ──── CUSTOMERS ──── -->
    <div id="view-customers" class="view-section hide">
      <div class="card">
        <div class="flex-between" style="margin-bottom:16px;">
          <span class="card-title">Registered Customers</span>
          <input type="text" id="cust-search" placeholder="Search..." class="inp" style="width:180px;margin:0;padding:8px 12px;font-size:0.82rem;" oninput="filterCustomers(this.value)">
        </div>
        <div class="tbl-wrap">
          <table id="customer-list-table">
            <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Orders</th><th>Spent</th><th>Joined</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ──── MARKETING ──── -->
    <div id="view-marketing" class="view-section hide">
      <div class="grid-2r">
        <div class="card">
          <div class="flex-between" style="margin-bottom:16px;">
            <span class="card-title">App Banners</span>
            <button class="btn b-prim b-sm" onclick="openModal('m-ban')"><i class="fa-solid fa-plus"></i> Add</button>
          </div>
          <div id="ban-list" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px;"></div>
        </div>
        <div class="card">
          <div class="flex-between" style="margin-bottom:16px;">
            <span class="card-title">Coupons</span>
            <button class="btn b-succ b-sm" onclick="openCoupModal()"><i class="fa-solid fa-plus"></i> New</button>
          </div>
          <div id="coup-list" style="margin-top:10px;"></div>
        </div>
      </div>
    </div>

    <!-- ──── DRIVERS ──── -->
    <div id="view-drivers" class="view-section hide">
      <div class="card">
        <div class="flex-between" style="margin-bottom:16px;">
          <span class="card-title">Delivery Drivers / Staff</span>
          <span class="text-sm" id="driver-count">0 active</span>
        </div>
        <div class="tbl-wrap">
          <table id="driver-list">
            <thead><tr><th>Name</th><th>Phone</th><th>Status</th><th>Deliveries</th><th>Actions</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ──── SETTINGS ──── -->
    <div id="view-settings" class="view-section hide">
      <div style="max-width:600px; margin:0 auto;">
        <div class="card">
          <div class="card-title" style="margin-bottom:20px;"><i class="fa-solid fa-sliders"></i> Master Control</div>
          <div style="border:1px solid #F0F0F0; padding:20px; border-radius:12px;">
            <div class="setting-row">
              <div><b>Cash on Delivery (COD)</b><div class="text-sm">Allow customers to pay by cash</div></div>
              <label class="switch"><input type="checkbox" id="set-cod"><span class="slider"></span></label>
            </div>
            <div class="setting-row">
              <div><b>Online Prepaid Discount (%)</b><div class="text-sm">Extra % OFF for online payments</div></div>
              <input type="number" id="set-online-disc" class="inp" style="width:80px;margin:0;" placeholder="0" min="0" max="50">
            </div>
          </div>
          <h4 style="margin:22px 0 14px;color:var(--brand);font-family:'Syne',sans-serif;">Delivery Config</h4>
          <div class="inp-grp">
            <div>
              <label class="lbl">Delivery Fee (₹)</label>
              <input type="number" id="set-del-fee" class="inp" placeholder="20" min="0">
            </div>
            <div>
              <label class="lbl">Free Delivery Above (₹)</label>
              <input type="number" id="set-free-min" class="inp" placeholder="500" min="0">
            </div>
          </div>
          <h4 style="margin:22px 0 14px;color:var(--brand);font-family:'Syne',sans-serif;">Order Config</h4>
          <div class="inp-grp">
            <div>
              <label class="lbl">Min Order Amount (₹)</label>
              <input type="number" id="set-min-order" class="inp" placeholder="100" min="0">
            </div>
            <div>
              <label class="lbl">Max Delivery Radius (km)</label>
              <input type="number" id="set-max-radius" class="inp" placeholder="10" min="1">
            </div>
          </div>
          <button class="btn b-prim" style="width:100%;padding:16px;margin-top:10px;" onclick="saveSettings()">
            <i class="fa-solid fa-save"></i> UPDATE MASTER CONTROLS
          </button>
        </div>
      </div>
    </div>

    <!-- ──── SECURITY LOG ──── -->
    <div id="view-security" class="view-section hide">
      <div style="max-width:700px;">
        <div class="card" style="margin-bottom:18px;">
          <div class="flex-between" style="margin-bottom:16px;">
            <span class="card-title"><i class="fa-solid fa-shield-halved"></i> Security Overview</span>
            <button class="btn b-dang b-sm" onclick="clearSecLog()"><i class="fa-solid fa-trash"></i> Clear Log</button>
          </div>
          <div class="grid-3" style="gap:14px;margin-bottom:16px;">
            <div style="background:#E8F5E9;padding:14px;border-radius:10px;text-align:center;">
              <div style="font-size:1.5rem;font-weight:800;color:var(--success);" id="sec-ok-count">0</div>
              <div class="text-sm">Successful Logins</div>
            </div>
            <div style="background:#FFEBEE;padding:14px;border-radius:10px;text-align:center;">
              <div style="font-size:1.5rem;font-weight:800;color:var(--danger);" id="sec-fail-count">0</div>
              <div class="text-sm">Failed Attempts</div>
            </div>
            <div style="background:#FFF3E0;padding:14px;border-radius:10px;text-align:center;">
              <div style="font-size:1.5rem;font-weight:800;color:var(--warn);" id="sec-session-age">0m</div>
              <div class="text-sm">Session Age</div>
            </div>
          </div>
          <div id="sec-log-list"></div>
        </div>
      </div>
    </div>

  </div><!-- END content -->
</main>

